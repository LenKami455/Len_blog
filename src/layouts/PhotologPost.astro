---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const { title, description, pubDate, updatedDate, heroImage, tags = [], category, postId } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric', month: 'long', day: 'numeric'
  });
}

// 同シリーズ内の前後ナビ
const allPosts = await getCollection('blog');
const isCebu = postId.includes('cebu');
const seriesPosts = allPosts
  .filter(p => p.data.category === 'フォトログ')
  .filter(p => p.id.includes('cebu') === isCebu)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const currentIndex = seriesPosts.findIndex(p => p.id === postId);
const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
const nextPost = currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;

function getVolLabel(id: string): string {
  const m = id.match(/vol(\d+)/i);
  const num = m ? m[1] : '';
  return id.includes('cebu') ? `Cebu vol.${num}` : `vol.${num}`;
}
---

<html lang="ja">
  <head>
    <BaseHead
      title={`${title} | ${SITE_TITLE}`}
      description={description}
      image={heroImage}
      article={{
        publishedTime: pubDate,
        modifiedTime: updatedDate,
        section: category,
        tags,
      }}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Noto+Serif+JP:wght@300;400&display=swap" rel="stylesheet" />
  </head>

  <body class="plp-body">

    <article class="plp-article">

      <!-- ── Article header ───────────────── -->
      <header class="plp-header">
        <a href="/photolog" class="plp-back">← photolog</a>
        <h1 class="plp-title">{title}</h1>
        <p class="plp-desc">{description}</p>
        <time class="plp-date" datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time>
      </header>

      <!-- ── Content ──────────────────────── -->
      <div class="plp-prose" data-auto-reveal=".pl-item">
        <slot />
      </div>

      <!-- ── いいね ───────────────────────── -->
      <div class="plp-like">
        <button class="plp-like-btn" id="plp-like-btn" type="button" aria-label="いいね" aria-pressed="false">
          <svg class="plp-like-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 10v12"/>
            <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>
          </svg>
          <span class="plp-like-count" id="plp-like-count"></span>
        </button>
      </div>

      <!-- ── Series nav（前後vol）─────────── -->
      {(prevPost || nextPost) && (
        <nav class="plp-series-nav" aria-label="シリーズナビゲーション">
          <div class="plp-sn-slot">
            {prevPost && (
              <a href={`/blog/${prevPost.id}/`} class="plp-sn-link plp-sn-prev">
                <span class="plp-sn-arrow">←</span>
                <span class="plp-sn-text">
                  <span class="plp-sn-label">Prev</span>
                  <span class="plp-sn-vol">{getVolLabel(prevPost.id)}</span>
                </span>
              </a>
            )}
          </div>
          <div class="plp-sn-slot plp-sn-slot--right">
            {nextPost && (
              <a href={`/blog/${nextPost.id}/`} class="plp-sn-link plp-sn-next">
                <span class="plp-sn-text">
                  <span class="plp-sn-label">Next</span>
                  <span class="plp-sn-vol">{getVolLabel(nextPost.id)}</span>
                </span>
                <span class="plp-sn-arrow">→</span>
              </a>
            )}
          </div>
        </nav>
      )}

    </article>

    <Footer />

    <!-- ── Floating nav ────────────────────── -->
    <div class="plp-fab">
      <a href="/photolog" class="plp-fab-btn plp-fab-back" aria-label="photolog一覧へ">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
      <button class="plp-fab-btn plp-fab-top" id="fab-top" aria-label="トップへ戻る">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
    </div>

    <!-- Lightbox -->
    <div id="lightbox" aria-hidden="true">
      <button id="lightbox-close" aria-label="閉じる">✕</button>
      <img id="lightbox-img" src="" alt="" />
    </div>
  </body>
</html>

<script>
// ── photolog ページの動的機能（View Transitions 対応：遷移ごとに再初期化）──

function plpCloseLightbox() {
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  if (!lightbox || !lbImg) return;
  lightbox.classList.remove('active');
  lightbox.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
  lbImg.src = '';
}

function initPlpLightbox() {
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbClose = document.getElementById('lightbox-close');
  if (!lightbox || !lbImg || !lbClose) return;

  document.querySelectorAll<HTMLImageElement>('.plp-prose img').forEach(img => {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  lbClose.addEventListener('click', plpCloseLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) plpCloseLightbox(); });
}

function initPlpFab() {
  document.getElementById('fab-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
}

function updateFabVisibility() {
  const fab = document.querySelector('.plp-fab') as HTMLElement | null;
  if (!fab) return;
  fab.style.opacity = window.scrollY > 200 ? '1' : '0';
  fab.style.pointerEvents = window.scrollY > 200 ? 'auto' : 'none';
}

// ── いいね（パーティクル付き）──
function spawnLikeParticles(btn: HTMLElement) {
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) return;
  const COLORS = ['#57735A', '#6e8871', '#9bb39d', '#c3d3c5'];
  for (let i = 0; i < 8; i++) {
    const p = document.createElement('span');
    p.className = 'plp-like-particle';
    const angle = (Math.PI * 2 * i) / 8 + (Math.random() - 0.5) * 0.6;
    const dist = 22 + Math.random() * 14;
    p.style.setProperty('--px', `${Math.cos(angle) * dist}px`);
    p.style.setProperty('--py', `${Math.sin(angle) * dist}px`);
    p.style.background = COLORS[i % COLORS.length];
    btn.appendChild(p);
    p.addEventListener('animationend', () => p.remove());
    setTimeout(() => p.remove(), 800); /* animationend が来ない環境へのフォールバック */
  }
}

function initPlpLike() {
  const btn = document.getElementById('plp-like-btn');
  const countEl = document.getElementById('plp-like-count');
  if (!btn || !countEl || btn.dataset.booted) return;
  btn.dataset.booted = '1';

  const serverURL = 'https://waline-rho-woad.vercel.app';
  const path = window.location.pathname;
  const storeKey = 'plp-liked:' + path;
  let count = 0;
  let liked = localStorage.getItem(storeKey) === '1';

  function render() {
    countEl.textContent = count > 0 ? String(count) : '';
    btn.classList.toggle('is-liked', liked);
    btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
  }

  function parseCount(json: any) {
    const c = json && json.data && json.data[0] && json.data[0].reaction0;
    return typeof c === 'number' ? c : 0;
  }

  async function loadCount() {
    try {
      const res = await fetch(
        `${serverURL}/api/article?path=${encodeURIComponent(path)}&type=reaction0&lang=jp-JP`
      );
      count = parseCount(await res.json());
      render();
    } catch { /* サーバー未応答時は0表示のまま */ }
  }

  btn.addEventListener('click', async () => {
    liked = !liked;
    count = Math.max(0, count + (liked ? 1 : -1));
    localStorage.setItem(storeKey, liked ? '1' : '0');
    render();
    if (liked) {
      btn.classList.remove('is-pop');
      void btn.offsetWidth; /* アニメ再発火のための reflow */
      btn.classList.add('is-pop');
      spawnLikeParticles(btn);
    }
    try {
      const res = await fetch(`${serverURL}/api/article?lang=jp-JP`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path, type: 'reaction0', action: liked ? 'inc' : 'desc' }),
      });
      count = parseCount(await res.json());
      render();
    } catch { /* 送信失敗は無視（ローカル表示は維持）*/ }
  });

  render();
  loadCount();
}

function initPhotologPage() {
  if (!document.querySelector('.plp-body')) return;
  initPlpLightbox();
  initPlpFab();
  initPlpLike();
  updateFabVisibility();
}

initPhotologPage();
document.addEventListener('astro:page-load', initPhotologPage);
window.addEventListener('scroll', updateFabVisibility, { passive: true });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') plpCloseLightbox(); });
</script>

<style>
/* ── Base ───────────────────────────────────── */
.plp-body {
  background: #fff;
  color: #1a1a1a;
}
.plp-body :global(footer) {
  background: #fff;
  border-top: 1px solid #e8e8e8;
}
/* ── Header overrides（photolog記事ページ） ─── */
.plp-body :global(.header-top) {
  background: #fff;
}
.plp-body :global(.header-compact) {
  background: rgba(255,255,255,0.96);
  border-bottom-color: #ebebeb;
}

/* ── Article ────────────────────────────────── */
.plp-article {
  min-height: 70vh;
}

/* ── Header ─────────────────────────────────── */
.plp-header {
  max-width: 960px;
  margin: 0 auto;
  padding: 2.5rem 2rem 2.5rem;
  border-bottom: 1px solid #e8e8e8;
  margin-bottom: 0;
}
.plp-back {
  display: inline-block;
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.85rem;
  letter-spacing: 0.18em;
  color: #999;
  text-decoration: none;
  margin-bottom: 2.5rem;
  transition: color .2s;
}
.plp-back:hover { color: #444; }

.plp-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: clamp(2.2rem, 6vw, 3.2rem);
  color: #111;
  letter-spacing: 0.04em;
  line-height: 1.25;
  margin: 0 0 1.25rem;
}
.plp-desc {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.85rem;
  color: #777;
  letter-spacing: 0.1em;
  line-height: 2.1;
  margin: 0 0 1.75rem;
}
.plp-date {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.8rem;
  letter-spacing: 0.25em;
  color: #999;
}

/* ── Prose ──────────────────────────────────── */
.plp-prose {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.9rem;
  line-height: 2.2;
  color: #333;
}

/* post-no label */
.plp-prose :global(.post-no) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.8rem;
  letter-spacing: 0.25em;
  color: #aaa;
  margin: 0;
  padding: 1.75rem 2rem 0;
  max-width: 960px;
  margin-left: auto;
  margin-right: auto;
  display: block;
}

/* intro blockquote */
.plp-prose :global(blockquote) {
  border-left: none;
  padding: 1rem 2rem 0;
  margin: 0 auto 0;
  max-width: 960px;
  background: none;
  border-radius: 0;
  font-style: normal;
}
.plp-prose :global(blockquote p) {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.85rem;
  color: #888;
  letter-spacing: 0.1em;
  line-height: 2.4;
  margin: 0;
}

/* ── Month header ───────────────────────────── */
.plp-prose :global(.pl-header) {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin: 4rem auto 2.5rem;
  max-width: 1200px;
  padding: 0 2rem;
}
.plp-prose :global(.pl-month) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 1rem;
  letter-spacing: 0.35em;
  color: #999;
  white-space: nowrap;
  flex-shrink: 0;
}
.plp-prose :global(.pl-header::after) {
  content: '';
  flex: 1;
  height: 1px;
  background: #ebebeb;
}

/* ── Series nav（前後volボタン）─ */
.plp-series-nav {
  max-width: 1200px;
  margin: 6rem auto 4rem;
  padding: 2rem 4rem 0;
  border-top: 1px solid #eee;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.plp-sn-slot {
  display: flex;
}
.plp-sn-slot--right {
  justify-content: flex-end;
}
.plp-sn-link {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 0.5rem;
  text-decoration: none;
  color: #999;
  transition: color .2s, gap .2s;
}
.plp-sn-link:hover {
  color: #333;
}
.plp-sn-prev:hover { gap: 1rem; }
.plp-sn-next:hover { gap: 1rem; }
.plp-sn-arrow {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 1.1rem;
  font-weight: 300;
}
.plp-sn-text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  line-height: 1;
}
.plp-sn-next .plp-sn-text { text-align: right; }
.plp-sn-label {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 0.6rem;
  letter-spacing: 0.4em;
  color: #bbb;
  text-transform: uppercase;
}
.plp-sn-vol {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-style: italic;
  font-size: 1rem;
  font-weight: 300;
}

/* ── いいね（控えめ）──────────────── */
.plp-like {
  display: flex;
  justify-content: center;
  padding: 2rem;
}
.plp-like-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: none;
  border: none;
  padding: 0.4rem 0.6rem;
  cursor: pointer;
  color: #c4c4c4;
  transition: color .2s;
}
.plp-like-btn:hover { color: #8a8a8a; }
.plp-like-btn.is-liked { color: #8a8a8a; }
.plp-like-btn.is-liked .plp-like-icon { fill: currentColor; }
.plp-like-icon { display: block; }

/* いいねのポップ + パーティクル */
.plp-like-btn { position: relative; }
.plp-like-btn.is-pop .plp-like-icon {
  animation: plp-like-pop .4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes plp-like-pop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.35) rotate(-8deg); }
  100% { transform: scale(1); }
}
:global(.plp-like-particle) {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  pointer-events: none;
  animation: plp-particle-fly .55s ease-out forwards;
}
@keyframes plp-particle-fly {
  0%   { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(calc(-50% + var(--px)), calc(-50% + var(--py))) scale(0.3); opacity: 0; }
}
.plp-like-count {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  min-width: 0.5ch;
}

/* ── Trip link card（旅行記事への誘導）─ */
.plp-prose :global(.trip-link-card) {
  max-width: 720px;
  margin: 2rem auto 3.5rem;
  padding: 1.5rem 1.75rem;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
}
.plp-prose :global(.trip-link-card .tlc-label) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 0.65rem;
  letter-spacing: 0.4em;
  color: #999;
  text-transform: uppercase;
  margin: 0;
  white-space: nowrap;
}
.plp-prose :global(.trip-link-card .tlc-link) {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-size: 0.95rem;
  font-weight: 400;
  color: #333;
  text-decoration: none;
  border-bottom: 1px solid #333;
  padding-bottom: 2px;
  transition: color .2s, border-color .2s;
}
.plp-prose :global(.trip-link-card .tlc-link:hover) {
  color: #888;
  border-color: #888;
}

/* ── Photo grid → full-width vertical stack ─ */
.plp-prose :global(.pl-grid) {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  margin: 0 auto 2rem;
  max-width: 1200px;
  padding: 0 2rem;
}

/* 通常画像：横画像はほぼフル幅、縦画像は自然なサイズで中央 */
.plp-prose :global(.pl-item) {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.plp-prose :global(.pl-item img) {
  /* クロップなし・自然サイズ表示 */
  width: 100%;
  height: auto;
  display: block;
  margin: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  transition: opacity .3s;
}
.plp-prose :global(.pl-item:hover img) {
  opacity: 0.96;
}

/* 横画像（通常）：1200px まで */
.plp-prose :global(.pl-item:not(.pl-item--wide):not(.pl-item--portrait) img[src]) {
  max-width: 1200px;
}

/* 縦画像：幅を絞って縦長を活かす */
.plp-prose :global(.pl-item--portrait img) {
  max-width: 480px;
}

/* wide はフル幅 */
.plp-prose :global(.pl-item--wide img) {
  max-width: 100%;
}

/* キャプション：画像の幅に揃える */
.plp-prose :global(.pl-cap) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  color: #bbb;
  margin-top: 0.75rem;
  text-align: right;
  width: 100%;
  max-width: 100%; /* 横写真はフル幅 */
  position: static !important;
  bottom: auto !important;
  right: auto !important;
  text-shadow: none !important;
  color: #bbb !important;
}
/* 縦写真は画像幅（480px）に合わせる */
.plp-prose :global(.pl-item--portrait .pl-cap) {
  max-width: 480px;
}

/* ── Sign-off ───────────────────────────────── */
.plp-prose :global(.sign-off) {
  text-align: center;
  padding: 5rem 0 2rem;
  border-top: 1px solid #ebebeb;
  margin-top: 5rem;
}
.plp-prose :global(.sign-off .s-name) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-style: italic;
  font-size: 1.5rem;
  color: #bbb;
  margin-bottom: 0.5rem;
  letter-spacing: 0.06em;
}
.plp-prose :global(.sign-off .s-message) {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  color: #ddd;
}

/* ── Lightbox ───────────────────────────────── */
#lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 999;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  cursor: zoom-out;
}
#lightbox.active { display: flex; animation: lb-in .25s ease; }
@keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
#lightbox-img {
  max-width: 100%;
  max-height: 92vh;
  object-fit: contain;
  cursor: default;
}
#lightbox.active #lightbox-img {
  animation: lb-img-in .32s cubic-bezier(0.22, 0.61, 0.36, 1);
}
@keyframes lb-img-in {
  from { transform: scale(0.955); opacity: 0.4; }
  to   { transform: scale(1); opacity: 1; }
}
#lightbox-close {
  position: fixed;
  top: 1.2rem;
  right: 1.5rem;
  background: rgba(255,255,255,0.1);
  border: none;
  color: #fff;
  font-size: 1rem;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s;
}
#lightbox-close:hover { background: rgba(255,255,255,0.25); }

/* ── Floating nav ───────────────────────────── */
.plp-fab {
