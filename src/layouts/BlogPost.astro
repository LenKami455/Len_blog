---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [], category } = Astro.props;
const pageUrl = Astro.url.href;
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(pageUrl);
---

<html lang="ja">
	<head>
		<BaseHead
			title={`${title} | ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			article={{
				publishedTime: pubDate,
				modifiedTime: updatedDate,
				section: category,
				tags,
			}}
		/>
		<link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
	</head>

	<body>
		<Header />

		<article class="article-wrap">
			<!-- Hero image -->
			{heroImage && (
				<div class="article-hero">
					<img src={heroImage} alt={title} loading="lazy" />
				</div>
			)}

			<div class="article-container">
				<!-- Sidebar (sticky on desktop) -->
				<aside class="article-aside">
					<div class="aside-inner">
						<div class="aside-date">
							<span class="aside-label">公開日</span>
							<FormattedDate date={pubDate} />
						</div>
						{updatedDate && (
							<div class="aside-date">
								<span class="aside-label">更新日</span>
								<FormattedDate date={updatedDate} />
							</div>
						)}
						{tags.length > 0 && (
							<div class="aside-tags">
								<span class="aside-label">タグ</span>
								<div class="tags-list">
									{tags.map((tag) => (
										<a href={`/tags/${tag}/`} class="tag-pill">#{tag}</a>
									))}
								</div>
							</div>
						)}
						<a href="/blog" class="back-link">← 記事一覧</a>
					</div>
				</aside>

				<!-- Main content -->
				<div class="article-main">
					<header class="article-header">
						{category && (
							<a href={`/tags/${category}/`} class="article-category">{category}</a>
						)}
						<h1 class="article-title">{title}</h1>
						<p class="article-description">{description}</p>
						<div class="article-meta-mobile">
							<span class="meta-date"><FormattedDate date={pubDate} /></span>
							{tags.length > 0 && (
								<div class="tags-list tags-list--inline">
									{tags.map((tag) => (
										<a href={`/tags/${tag}/`} class="tag-pill">#{tag}</a>
									))}
								</div>
							)}
						</div>
						<hr class="article-divider" />
					</header>

					<div class="prose">
						<slot />
					</div>

					<footer class="article-footer">
						<div class="article-footer-tags">
							{tags.map((tag) => (
								<a href={`/tags/${tag}/`} class="tag-pill tag-pill--lg">#{tag}</a>
							))}
						</div>
						<a href="/blog" class="btn-back">← 記事一覧に戻る</a>
					</footer>
				</div>
			</div>
		</article>

		<!-- シェアボタン -->
		<div class="share-section">
			<div class="share-inner">
				<p class="share-label">この記事をシェア</p>
				<div class="share-buttons">
					<a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}&via=LenKamikawa`} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--x">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
						X でシェア
					</a>
					<a href={`https://social-plugins.line.me/lineit/share?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--line">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
						LINE でシェア
					</a>
					<a href={`https://b.hatena.ne.jp/add?mode=confirm&url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener noreferrer" class="share-btn share-btn--hatena">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.47 0C22.42 0 24 1.58 24 3.53v16.94C24 22.42 22.42 24 20.47 24H3.53C1.58 24 0 22.42 0 20.47V3.53C0 1.58 1.58 0 3.53 0h16.94zm-3.705 14.47c-.57 0-1.032.46-1.032 1.03 0 .57.462 1.032 1.032 1.032.57 0 1.03-.462 1.03-1.032 0-.57-.46-1.03-1.03-1.03zm-5.515-1.928c-.005 0-.005 0 0 0-1.246.005-2.168.936-2.168 2.09 0 1.15.929 2.082 2.168 2.082 1.246 0 2.174-.932 2.174-2.082s-.928-2.085-2.174-2.09zm5.328.076h-1.72v3.862h1.72V12.62zm-5.328.9c.674 0 1.176.525 1.176 1.19 0 .664-.502 1.19-1.176 1.19-.668 0-1.177-.526-1.177-1.19 0-.665.51-1.19 1.177-1.19zM11.247 7.5c-1.246 0-2.168.93-2.168 2.08 0 1.152.922 2.083 2.168 2.083 1.24 0 2.168-.931 2.168-2.082S12.488 7.5 11.247 7.5zm5.328.11h-1.72v3.861h1.72V7.61zm-5.328.896c.674 0 1.176.525 1.176 1.19 0 .663-.502 1.188-1.176 1.188-.668 0-1.177-.525-1.177-1.189 0-.664.51-1.189 1.177-1.189z"/></svg>
						はてブ
					</a>
				</div>
			</div>
		</div>

		<!-- コメント欄 -->
		<div class="comment-section">
			<div class="comment-inner">
				<h2 class="comment-title">コメント</h2>
				<div id="waline"></div>
			</div>
		</div>

		<Footer />

		<!-- Waline コメント初期化 -->
		<script type="module">
			import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
			init({
				el: '#waline',
				serverURL: 'https://waline-rho-woad.vercel.app',
				lang: 'jp-JP',
				placeholder: 'コメントを書く...',
				requiredMeta: ['nick'],
				login: 'disable',
				pageview: true,
				reaction: ['/reaction-like.svg'],
				locale: { reaction0: 'いいね', reactionTitle: 'この記事はいかがでしたか？' },
			});
		</script>

		<!-- Lightbox -->
		<div id="lightbox" aria-hidden="true">
			<button id="lightbox-close" aria-label="閉じる">✕</button>
			<img id="lightbox-img" src="" alt="" />
		</div>
	</body>
</html>

<script>
const lightbox = document.getElementById('lightbox')!;
const lbImg    = document.getElementById('lightbox-img') as HTMLImageElement;
const lbClose  = document.getElementById('lightbox-close')!;

// prose 内の全画像にクリックイベントを付与
document.querySelectorAll<HTMLImageElement>('.prose img').forEach(img => {
	img.style.cursor = 'zoom-in';
	img.addEventListener('click', () => {
		lbImg.src = img.src;
		lbImg.alt = img.alt;
		lightbox.classList.add('active');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	});
});

function closeLightbox() {
	lightbox.classList.remove('active');
	lightbox.setAttribute('aria-hidden', 'true');
	document.body.style.overflow = '';
	lbImg.src = '';
}

lbClose.addEventListener('click', closeLightbox);
lightbox.addEventListener('click', (e) => {
	if (e.target === lightbox) closeLightbox();
});
document.addEventListener('keydown', (e) => {
	if (e.key === 'Escape') closeLightbox();
});
</script>

<style>
.article-wrap { min-height: 60vh; }

/* ── シェアボタン ───────────────────────────────── */
.share-section {
	border-top: 1px solid var(--color-border);
	padding: 2.5rem 0;
	background: var(--color-bg);
}
.share-inner {
	max-width: 860px;
	margin: 0 auto;
	padding: 0 2rem;
	display: flex;
	align-items: center;
	gap: 1.5rem;
	flex-wrap: wrap;
}
.share-label {
	font-size: 0.72rem;
	letter-spacing: 0.2em;
	text-transform: uppercase;
	color: var(--color-text-light);
	white-space: nowrap;
	margin: 0;
}
.share-buttons {
	display: flex;
	gap: 0.6rem;
	flex-wrap: wrap;
}
.share-btn {
	display: inline-flex;
	align-items: center;
	gap: 0.45em;
	font-size: 0.78rem;
	letter-spacing: 0.04em;
	padding: 0.45em 1em;
	border-radius: var(--radius-sm);
	text-decoration: none;
	transition: opacity .2s, transform .15s;
	color: #fff;
}
.share-btn:hover { opacity: 0.85; transform: translateY(-1px); }
.share-btn svg { width: 1em; height: 1em; flex-shrink: 0; }
.share-btn--x       { background: #000; }
.share-btn--line    { background: #06C755; }
.share-btn--hatena  { background: #00A4DE; }
@media (max-width: 600px) {
	.share-inner { gap: 1rem; }
}

/* ── コメント欄 ─────────────────────────────────── */
.comment-section {
	background: var(--color-bg-alt);
	border-top: 1px solid var(--color-border);
	padding: 3rem 0 4rem;
}
.comment-inner {
	max-width: 860px;
	margin: 0 auto;
	padding: 0 2rem;
}
.comment-title {
	font-family: var(--font-serif);
	font-size: 1.2rem;
	color: var(--color-text);
	margin-bottom: 1.75rem;
	padding-bottom: 0.75rem;
	border-bottom: 1px solid var(--color-border);
}
/* Waline カラー調整 */
:root {
	--waline-theme-color: #8B5E3C;
	--waline-active-color: #8B5E3C;
	--waline-bgcolor: var(--color-surface);
	--waline-bgcolor-light: var(--color-bg-alt);
	--waline-border-color: var(--color-border);
	--waline-font-size: 0.88rem;
}
@media (max-width: 600px) {
	.comment-inner { padding: 0 1rem; }
}

/* ── Hero image ─────────────────────────────────── */
.article-hero {
	width: 100%;
	max-height: 480px;
	overflow: hidden;
}
.article-hero img {
	width: 100%;
	height: 480px;
	object-fit: cover;
	display: block;
	border-radius: 0;
}

/* ── Layout ─────────────────────────────────────── */
.article-container {
	max-width: 1100px;
	margin: 0 auto;
	padding: 3rem 2rem 5rem;
	display: grid;
	grid-template-columns: 220px 1fr;
	gap: 4rem;
	align-items: start;
}

/* ── Aside ──────────────────────────────────────── */
.article-aside {
	position: sticky;
	top: 80px;
}
.aside-inner {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}
.aside-date {
	display: flex;
	flex-direction: column;
	gap: 0.2rem;
	font-size: 0.85rem;
	color: var(--color-text);
}
.aside-label {
	font-size: 0.72rem;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--color-text-light);
}
.aside-tags { display: flex; flex-direction: column; gap: 0.5rem; }
.tags-list { display: flex; flex-wrap: wrap; gap: 0.4em; }
.tags-list--inline { margin-top: 0.4rem; }
.back-link {
	display: inline-block;
	font-size: 0.83rem;
	color: var(--color-text-muted);
	text-decoration: none;
	padding-top: 1rem;
	border-top: 1px solid var(--color-border);
	transition: color .2s;
}
.back-link:hover { color: var(--color-accent); }

/* ── Article header ─────────────────────────────── */
.article-header { margin-bottom: 2rem; }
.article-category {
	display: inline-block;
	margin-bottom: 0.9rem;
	padding: 0.25em 0.9em;
	background: var(--color-accent-bg);
	color: var(--color-accent);
	border-radius: var(--radius-sm);
	font-size: 0.78rem;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-decoration: none;
	text-transform: uppercase;
	transition: background .2s;
}
.article-category:hover { background: var(--color-accent); color: #fff; }
.article-title {
	font-family: var(--font-serif);
	font-size: clamp(1.6rem, 4vw, 2.4rem);
	font-weight: 700;
	color: var(--color-text);
	line-height: 1.3;
	letter-spacing: 0.02em;
	margin: 0 0 0.8rem;
}
.article-description {
	font-size: 1.05rem;
	color: var(--color-text-muted);
	line-height: 1.7;
	margin: 0 0 1.2rem;
}
.article-meta-mobile {
	display: none;
	gap: 0.5rem;
	flex-wrap: wrap;
	align-items: center;
}
.meta-date { font-size: 0.82rem; color: var(--color-text-light); }
.article-divider { margin: 1.5rem 0 0; }

/* ── 記事番号ラベル（No. 001 · first post） ─────── */
.prose :global(.post-no) {
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 0.8rem;
	letter-spacing: 0.18em;
	color: var(--color-text-light);
	margin: 0 0 0.5rem;
}

/* ── Prose (article body) ───────────────────────── */
.prose {
	font-size: 1.05rem;
	line-height: 1.95;
	color: var(--color-text);
}
.prose :global(h2) {
	font-family: var(--font-serif);
	font-size: 1.5rem;
	font-weight: 700;
	margin: 3rem 0 1rem;
	color: var(--color-text);
	padding-bottom: 0.5rem;
	border-bottom: 1px solid var(--color-border);
}
.prose :global(h3) {
	font-family: var(--font-serif);
	font-size: 1.2rem;
	margin: 2.2rem 0 0.75rem;
}
.prose :global(p)     { margin-bottom: 1.8rem; }
.prose :global(img)   { border-radius: var(--radius-md); box-shadow: var(--shadow-sm); margin: 1.5rem 0; }
.prose :global(a)     { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
.prose :global(blockquote) {
	border-left: 3px solid var(--color-accent);
	padding: 0.6em 1.2em;
	margin: 2rem 0;
	background: var(--color-accent-bg);
	border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
	color: var(--color-text-muted);
	font-style: italic;
}
.prose :global(ul), .prose :global(ol) { padding-left: 1.6em; margin-bottom: 1.8rem; }
.prose :global(li) { margin-bottom: 0.5rem; }

/* ── Lightbox ───────────────────────────────────── */
#lightbox {
	display: none;
	position: fixed;
	inset: 0;
	background: rgba(20, 15, 10, 0.92);
	z-index: 999;
	align-items: center;
	justify-content: center;
	padding: 1.5rem;
	backdrop-filter: blur(4px);
	-webkit-backdrop-filter: blur(4px);
	cursor: zoom-out;
}
#lightbox.active {
	display: flex;
	animation: lb-in .18s ease;
}
@keyframes lb-in {
	from { opacity: 0; }
	to   { opacity: 1; }
}
#lightbox-img {
	max-width: 100%;
	max-height: 90vh;
	object-fit: contain;
	border-radius: var(--radius-md);
	box-shadow: 0 8px 48px rgba(0,0,0,.6);
	cursor: default;
}
#lightbox-close {
	position: fixed;
	top: 1.2rem;
	right: 1.5rem;
	background: rgba(255,255,255,0.12);
	border: none;
	color: #fff;
	font-size: 1.1rem;
	width: 2.2rem;
	height: 2.2rem;
	border-radius: 50%;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background .2s;
	line-height: 1;
}
#lightbox-close:hover { background: rgba(255,255,255,0.25); }

/* ── Gear card ──────────────────────────────────── */
.prose :global(.gear-card) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	overflow: hidden;
	margin-bottom: 1rem;
	box-shadow: var(--shadow-sm);
}
.prose :global(.gear-card-inner) {
	padding: 1.75rem 2rem;
}
.prose :global(.gear-photo) {
	width: 100%;
	max-height: 380px;
	object-fit: cover;
	border-radius: var(--radius-md);
	margin-bottom: 1.25rem;
	display: block;
}
.prose :global(.gear-eyebrow) {
	font-size: 0.65rem;
	letter-spacing: 0.35em;
	text-transform: uppercase;
	color: var(--color-accent-h);
	margin-bottom: 0.5rem;
}
.prose :global(.gear-name) {
	font-family: var(--font-serif);
	font-size: 1.15rem;
	font-weight: 500;
	color: var(--color-text);
	letter-spacing: 0.04em;
	margin-bottom: 0.3rem;
	line-height: 1.5;
}
.prose :global(.gear-name-en) {
	display: block;
	font-size: 0.72rem;
	letter-spacing: 0.12em;
	color: var(--color-text-light);
	margin-bottom: 1.2rem;
}
.prose :global(.gear-desc) {
	font-size: 0.9rem;
	line-height: 2.1;
	color: var(--color-text-muted);
}
.prose :global(.gear-specs) {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4rem;
	margin-top: 1.1rem;
	padding-top: 1.1rem;
	border-top: 1px solid var(--color-border);
}
.prose :global(.spec) {
	background: var(--color-accent-bg);
	color: var(--color-accent);
	font-size: 0.68rem;
	letter-spacing: 0.05em;
	padding: 0.3em 0.7em;
	border-radius: var(--radius-sm);
}
.prose :global(.spec.highlight) {
	background: var(--color-text);
	color: rgba(255,255,255,0.85);
}

/* ── Lens grid ───────────────────────────────────── */
.prose :global(.lens-grid) {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 0.875rem;
	margin: 1.5rem 0 2rem;
}
.prose :global(.lens-card) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 0;
	position: relative;
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
.prose :global(.lens-photo) {
	width: 100%;
	height: 180px;
	object-fit: cover;
	display: block;
	flex-shrink: 0;
}
.prose :global(.lens-number),
.prose :global(.lens-use),
.prose :global(.lens-name),
.prose :global(.lens-aperture),
.prose :global(.lens-comment) {
	padding-left: 1.25rem;
	padding-right: 1.25rem;
}
.prose :global(.lens-number) {
	padding-top: 1rem;
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 2rem;
	color: var(--color-border);
	line-height: 1;
	user-select: none;
}
.prose :global(.lens-link) {
	margin-left: 1.25rem !important;
	margin-right: 1.25rem !important;
}
.prose :global(.lens-use) {
	font-size: 0.65rem;
	letter-spacing: 0.25em;
	color: var(--color-accent-h);
	text-transform: uppercase;
	margin-bottom: 0.6rem;
}
.prose :global(.lens-name) {
	font-family: var(--font-serif);
	font-size: 0.85rem;
	font-weight: 500;
	color: var(--color-text);
	margin-bottom: 0.25rem;
	line-height: 1.6;
	padding-right: 1.5rem;
}
.prose :global(.lens-aperture) {
	font-size: 0.72rem;
	color: var(--color-accent-h);
	letter-spacing: 0.08em;
	margin-bottom: 0.875rem;
}
.prose :global(.lens-comment) {
	font-size: 0.78rem;
	line-height: 1.9;
	color: var(--color-text-muted);
}
@media (max-width: 600px) {
	.prose :global(.lens-grid) { grid-template-columns: 1fr; }
}

/* ── Summary box ─────────────────────────────────── */
.prose :global(.summary-box) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 1.75rem 2rem;
	margin: 2.5rem 0;
