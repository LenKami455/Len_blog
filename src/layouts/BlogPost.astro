---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [], category } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />

		<article class="article-wrap">
			<!-- Hero image -->
			{heroImage && (
				<div class="article-hero">
					<img src={heroImage} alt={title} loading="lazy" />
				</div>
			)}

			<div class="article-container">
				<!-- Sidebar (sticky on desktop) -->
				<aside class="article-aside">
					<div class="aside-inner">
						<div class="aside-date">
							<span class="aside-label">公開日</span>
							<FormattedDate date={pubDate} />
						</div>
						{updatedDate && (
							<div class="aside-date">
								<span class="aside-label">更新日</span>
								<FormattedDate date={updatedDate} />
							</div>
						)}
						{tags.length > 0 && (
							<div class="aside-tags">
								<span class="aside-label">タグ</span>
								<div class="tags-list">
									{tags.map((tag) => (
										<a href={`/tags/${tag}/`} class="tag-pill">#{tag}</a>
									))}
								</div>
							</div>
						)}
						<a href="/blog" class="back-link">← 記事一覧</a>
					</div>
				</aside>

				<!-- Main content -->
				<div class="article-main">
					<header class="article-header">
						{category && (
							<a href={`/tags/${category}/`} class="article-category">{category}</a>
						)}
						<h1 class="article-title">{title}</h1>
						<p class="article-description">{description}</p>
						<div class="article-meta-mobile">
							<span class="meta-date"><FormattedDate date={pubDate} /></span>
							{tags.length > 0 && (
								<div class="tags-list tags-list--inline">
									{tags.map((tag) => (
										<a href={`/tags/${tag}/`} class="tag-pill">#{tag}</a>
									))}
								</div>
							)}
						</div>
						<hr class="article-divider" />
					</header>

					<div class="prose">
						<slot />
					</div>

					<footer class="article-footer">
						<div class="article-footer-tags">
							{tags.map((tag) => (
								<a href={`/tags/${tag}/`} class="tag-pill tag-pill--lg">#{tag}</a>
							))}
						</div>
						<a href="/blog" class="btn-back">← 記事一覧に戻る</a>
					</footer>
				</div>
			</div>
		</article>

		<Footer />

		<!-- Lightbox -->
		<div id="lightbox" aria-hidden="true">
			<button id="lightbox-close" aria-label="閉じる">✕</button>
			<img id="lightbox-img" src="" alt="" />
		</div>
	</body>
</html>

<script>
const lightbox = document.getElementById('lightbox')!;
const lbImg    = document.getElementById('lightbox-img') as HTMLImageElement;
const lbClose  = document.getElementById('lightbox-close')!;

// prose 内の全画像にクリックイベントを付与
document.querySelectorAll<HTMLImageElement>('.prose img').forEach(img => {
	img.style.cursor = 'zoom-in';
	img.addEventListener('click', () => {
		lbImg.src = img.src;
		lbImg.alt = img.alt;
		lightbox.classList.add('active');
		lightbox.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	});
});

function closeLightbox() {
	lightbox.classList.remove('active');
	lightbox.setAttribute('aria-hidden', 'true');
	document.body.style.overflow = '';
	lbImg.src = '';
}

lbClose.addEventListener('click', closeLightbox);
lightbox.addEventListener('click', (e) => {
	if (e.target === lightbox) closeLightbox();
});
document.addEventListener('keydown', (e) => {
	if (e.key === 'Escape') closeLightbox();
});
</script>

<style>
.article-wrap { min-height: 60vh; }

/* ── Hero image ─────────────────────────────────── */
.article-hero {
	width: 100%;
	max-height: 480px;
	overflow: hidden;
}
.article-hero img {
	width: 100%;
	height: 480px;
	object-fit: cover;
	display: block;
	border-radius: 0;
}

/* ── Layout ─────────────────────────────────────── */
.article-container {
	max-width: 1100px;
	margin: 0 auto;
	padding: 3rem 2rem 5rem;
	display: grid;
	grid-template-columns: 220px 1fr;
	gap: 4rem;
	align-items: start;
}

/* ── Aside ──────────────────────────────────────── */
.article-aside {
	position: sticky;
	top: 80px;
}
.aside-inner {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}
.aside-date {
	display: flex;
	flex-direction: column;
	gap: 0.2rem;
	font-size: 0.85rem;
	color: var(--color-text);
}
.aside-label {
	font-size: 0.72rem;
	letter-spacing: 0.1em;
	text-transform: uppercase;
	color: var(--color-text-light);
}
.aside-tags { display: flex; flex-direction: column; gap: 0.5rem; }
.tags-list { display: flex; flex-wrap: wrap; gap: 0.4em; }
.tags-list--inline { margin-top: 0.4rem; }
.back-link {
	display: inline-block;
	font-size: 0.83rem;
	color: var(--color-text-muted);
	text-decoration: none;
	padding-top: 1rem;
	border-top: 1px solid var(--color-border);
	transition: color .2s;
}
.back-link:hover { color: var(--color-accent); }

/* ── Article header ─────────────────────────────── */
.article-header { margin-bottom: 2rem; }
.article-category {
	display: inline-block;
	margin-bottom: 0.9rem;
	padding: 0.25em 0.9em;
	background: var(--color-accent-bg);
	color: var(--color-accent);
	border-radius: var(--radius-sm);
	font-size: 0.78rem;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-decoration: none;
	text-transform: uppercase;
	transition: background .2s;
}
.article-category:hover { background: var(--color-accent); color: #fff; }
.article-title {
	font-family: var(--font-serif);
	font-size: clamp(1.6rem, 4vw, 2.4rem);
	font-weight: 700;
	color: var(--color-text);
	line-height: 1.3;
	letter-spacing: 0.02em;
	margin: 0 0 0.8rem;
}
.article-description {
	font-size: 1.05rem;
	color: var(--color-text-muted);
	line-height: 1.7;
	margin: 0 0 1.2rem;
}
.article-meta-mobile {
	display: none;
	gap: 0.5rem;
	flex-wrap: wrap;
	align-items: center;
}
.meta-date { font-size: 0.82rem; color: var(--color-text-light); }
.article-divider { margin: 1.5rem 0 0; }

/* ── 記事番号ラベル（No. 001 · first post） ─────── */
.prose :global(.post-no) {
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 0.8rem;
	letter-spacing: 0.18em;
	color: var(--color-text-light);
	margin: 0 0 0.5rem;
}

/* ── Prose (article body) ───────────────────────── */
.prose {
	font-size: 1.05rem;
	line-height: 1.95;
	color: var(--color-text);
}
.prose :global(h2) {
	font-family: var(--font-serif);
	font-size: 1.5rem;
	font-weight: 700;
	margin: 3rem 0 1rem;
	color: var(--color-text);
	padding-bottom: 0.5rem;
	border-bottom: 1px solid var(--color-border);
}
.prose :global(h3) {
	font-family: var(--font-serif);
	font-size: 1.2rem;
	margin: 2.2rem 0 0.75rem;
}
.prose :global(p)     { margin-bottom: 1.8rem; }
.prose :global(img)   { border-radius: var(--radius-md); box-shadow: var(--shadow-sm); margin: 1.5rem 0; }
.prose :global(a)     { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
.prose :global(blockquote) {
	border-left: 3px solid var(--color-accent);
	padding: 0.6em 1.2em;
	margin: 2rem 0;
	background: var(--color-accent-bg);
	border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
	color: var(--color-text-muted);
	font-style: italic;
}
.prose :global(ul), .prose :global(ol) { padding-left: 1.6em; margin-bottom: 1.8rem; }
.prose :global(li) { margin-bottom: 0.5rem; }

/* ── Lightbox ───────────────────────────────────── */
#lightbox {
	display: none;
	position: fixed;
	inset: 0;
	background: rgba(20, 15, 10, 0.92);
	z-index: 999;
	align-items: center;
	justify-content: center;
	padding: 1.5rem;
	backdrop-filter: blur(4px);
	-webkit-backdrop-filter: blur(4px);
	cursor: zoom-out;
}
#lightbox.active {
	display: flex;
	animation: lb-in .18s ease;
}
@keyframes lb-in {
	from { opacity: 0; }
	to   { opacity: 1; }
}
#lightbox-img {
	max-width: 100%;
	max-height: 90vh;
	object-fit: contain;
	border-radius: var(--radius-md);
	box-shadow: 0 8px 48px rgba(0,0,0,.6);
	cursor: default;
}
#lightbox-close {
	position: fixed;
	top: 1.2rem;
	right: 1.5rem;
	background: rgba(255,255,255,0.12);
	border: none;
	color: #fff;
	font-size: 1.1rem;
	width: 2.2rem;
	height: 2.2rem;
	border-radius: 50%;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background .2s;
	line-height: 1;
}
#lightbox-close:hover { background: rgba(255,255,255,0.25); }

/* ── Gear card ──────────────────────────────────── */
.prose :global(.gear-card) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	overflow: hidden;
	margin-bottom: 1rem;
	box-shadow: var(--shadow-sm);
}
.prose :global(.gear-card-inner) {
	padding: 1.75rem 2rem;
}
.prose :global(.gear-photo) {
	width: 100%;
	max-height: 380px;
	object-fit: cover;
	border-radius: var(--radius-md);
	margin-bottom: 1.25rem;
	display: block;
}
.prose :global(.gear-eyebrow) {
	font-size: 0.65rem;
	letter-spacing: 0.35em;
	text-transform: uppercase;
	color: var(--color-accent-h);
	margin-bottom: 0.5rem;
}
.prose :global(.gear-name) {
	font-family: var(--font-serif);
	font-size: 1.15rem;
	font-weight: 500;
	color: var(--color-text);
	letter-spacing: 0.04em;
	margin-bottom: 0.3rem;
	line-height: 1.5;
}
.prose :global(.gear-name-en) {
	display: block;
	font-size: 0.72rem;
	letter-spacing: 0.12em;
	color: var(--color-text-light);
	margin-bottom: 1.2rem;
}
.prose :global(.gear-desc) {
	font-size: 0.9rem;
	line-height: 2.1;
	color: var(--color-text-muted);
}
.prose :global(.gear-specs) {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4rem;
	margin-top: 1.1rem;
	padding-top: 1.1rem;
	border-top: 1px solid var(--color-border);
}
.prose :global(.spec) {
	background: var(--color-accent-bg);
	color: var(--color-accent);
	font-size: 0.68rem;
	letter-spacing: 0.05em;
	padding: 0.3em 0.7em;
	border-radius: var(--radius-sm);
}
.prose :global(.spec.highlight) {
	background: var(--color-text);
	color: rgba(255,255,255,0.85);
}

/* ── Lens grid ───────────────────────────────────── */
.prose :global(.lens-grid) {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 0.875rem;
	margin: 1.5rem 0 2rem;
}
.prose :global(.lens-card) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 0;
	position: relative;
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
.prose :global(.lens-photo) {
	width: 100%;
	height: 180px;
	object-fit: cover;
	display: block;
	flex-shrink: 0;
}
.prose :global(.lens-number),
.prose :global(.lens-use),
.prose :global(.lens-name),
.prose :global(.lens-aperture),
.prose :global(.lens-comment) {
	padding-left: 1.25rem;
	padding-right: 1.25rem;
}
.prose :global(.lens-number) {
	padding-top: 1rem;
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 2rem;
	color: var(--color-border);
	line-height: 1;
	user-select: none;
}
.prose :global(.lens-link) {
	margin-left: 1.25rem !important;
	margin-right: 1.25rem !important;
}
.prose :global(.lens-use) {
	font-size: 0.65rem;
	letter-spacing: 0.25em;
	color: var(--color-accent-h);
	text-transform: uppercase;
	margin-bottom: 0.6rem;
}
.prose :global(.lens-name) {
	font-family: var(--font-serif);
	font-size: 0.85rem;
	font-weight: 500;
	color: var(--color-text);
	margin-bottom: 0.25rem;
	line-height: 1.6;
	padding-right: 1.5rem;
}
.prose :global(.lens-aperture) {
	font-size: 0.72rem;
	color: var(--color-accent-h);
	letter-spacing: 0.08em;
	margin-bottom: 0.875rem;
}
.prose :global(.lens-comment) {
	font-size: 0.78rem;
	line-height: 1.9;
	color: var(--color-text-muted);
}
@media (max-width: 600px) {
	.prose :global(.lens-grid) { grid-template-columns: 1fr; }
}

/* ── Summary box ─────────────────────────────────── */
.prose :global(.summary-box) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 1.75rem 2rem;
	margin: 2.5rem 0;
	box-shadow: var(--shadow-sm);
}
.prose :global(.summary-box .s-label) {
	font-size: 0.65rem;
	letter-spacing: 0.3em;
	text-transform: uppercase;
	color: var(--color-accent-h);
	margin-bottom: 1rem;
}
.prose :global(.summary-box ul) {
	list-style: none;
	padding: 0;
	margin: 0;
}
.prose :global(.summary-box li) {
	font-size: 0.88rem;
	line-height: 2;
	color: var(--color-accent);
	display: flex;
	align-items: flex-start;
	gap: 0.6rem;
	margin-bottom: 0;
}
.prose :global(.summary-box li::before) {
	content: '→';
	color: var(--color-accent-h);
	font-size: 0.78rem;
	margin-top: 0.4rem;
	flex-shrink: 0;
}

/* ── Photo trio ──────────────────────────────────── */
.prose :global(.photo-trio) {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 0.75rem;
	margin: 2rem 0 2.5rem;
}
.prose :global(.photo-trio figure) {
	margin: 0;
}
.prose :global(.photo-trio img) {
	width: 100%;
	height: 200px;
	object-fit: cover;
	border-radius: var(--radius-md);
	box-shadow: var(--shadow-sm);
	display: block;
	margin: 0;
}
.prose :global(.photo-trio figcaption) {
	font-size: 0.68rem;
	letter-spacing: 0.1em;
	color: var(--color-text-light);
	text-align: center;
	margin-top: 0.5rem;
}
@media (max-width: 600px) {
	.prose :global(.photo-trio) { grid-template-columns: 1fr; }
	.prose :global(.photo-trio img) { height: 240px; }
}

/* ── Amazon links ────────────────────────────────── */
.prose :global(.gear-links) {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin-top: 1.1rem;
	padding-top: 1.1rem;
	border-top: 1px solid var(--color-border);
}
.prose :global(.gear-link),
.prose :global(.lens-link) {
	display: inline-block;
	font-size: 0.75rem;
	letter-spacing: 0.06em;
	color: var(--color-accent);
	text-decoration: none;
	padding: 0.35em 0.9em;
	border: 1px solid var(--color-accent);
	border-radius: var(--radius-sm);
	transition: background .2s, color .2s;
}
.prose :global(.gear-link:hover),
.prose :global(.lens-link:hover) {
	background: var(--color-accent);
	color: #fff;
}
.prose :global(.lens-link) {
	display: block;
	margin-top: 0.75rem;
	text-align: center;
}

/* ── Lens Block (large card style) ──────────────── */
.prose :global(.lens-block) {
	margin-bottom: 4rem;
}
.prose :global(.lb-header) {
	display: flex;
	align-items: flex-end;
	gap: 1rem;
	margin-bottom: 1.5rem;
	padding-bottom: 1rem;
	border-bottom: 1px solid var(--color-border);
	flex-wrap: wrap;
}
.prose :global(.lb-num) {
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 3rem;
	color: var(--color-border);
	line-height: 1;
	flex-shrink: 0;
}
.prose :global(.lb-category) {
	font-size: 0.65rem;
	letter-spacing: 0.3em;
	text-transform: uppercase;
	color: var(--color-accent-h);
	margin-bottom: 0.25rem;
}
.prose :global(.lb-name) {
	font-family: var(--font-serif);
	font-size: 1.35rem;
	font-weight: 500;
	color: var(--color-text);
	letter-spacing: 0.05em;
	line-height: 1.3;
}
.prose :global(.lb-aperture) {
	display: block;
	font-size: 0.72rem;
	color: var(--color-text-light);
	letter-spacing: 0.12em;
	margin-top: 0.2rem;
}
.prose :global(.lb-badge) {
	margin-left: auto;
	flex-shrink: 0;
	align-self: center;
	background: var(--color-text);
	color: rgba(255,255,255,0.82);
	font-size: 0.65rem;
	letter-spacing: 0.12em;
	padding: 0.35em 0.85em;
	border-radius: var(--radius-sm);
	white-space: nowrap;
}
.prose :global(.lb-body) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 1.75rem 2rem;
	box-shadow: var(--shadow-sm);
}
.prose :global(.lb-main) {
	display: flex;
	gap: 2rem;
	align-items: flex-start;
	margin-bottom: 1.75rem;
}
.prose :global(.lb-gear-img) {
	width: 220px;
	height: 260px;
	flex-shrink: 0;
	object-fit: contain;
	background: var(--color-bg);
	border-radius: var(--radius-sm);
}
.prose :global(.lb-desc) {
	flex: 1;
}
.prose :global(.lb-desc p) {
	font-size: 0.9rem;
	line-height: 2.1;
	color: var(--color-text-muted);
	margin-bottom: 1.1rem;
}
.prose :global(.lb-desc p:last-child) { margin-bottom: 0; }
.prose :global(.lb-sample) {
	margin-bottom: 1.5rem;
}
.prose :global(.lb-sample img) {
	width: 100%;
	max-height: 460px;
	object-fit: cover;
	border-radius: var(--radius-sm);
	display: block;
	box-shadow: none !important;
	margin: 0 !important;
}
.prose :global(.lb-caption) {
	font-size: 0.72rem;
	color: var(--color-text-light);
	letter-spacing: 0.1em;
	text-align: center;
	margin-top: 0.5rem;
}
@media (max-width: 700px) {
	.prose :global(.lb-main) { flex-direction: column; }
	.prose :global(.lb-gear-img) { width: 100%; height: 220px; }
	.prose :global(.lb-body) { padding: 1.4rem 1.25rem; }
}

/* ── Dripper block ───────────────────────────────── */
.prose :global(.dripper-block) {
	margin-bottom: 4rem;
}
.prose :global(.dripper-header) {
	display: flex;
	align-items: flex-end;
	gap: 1rem;
	margin-bottom: 1.5rem;
	padding-bottom: 1rem;
	border-bottom: 1px solid var(--color-border);
	flex-wrap: wrap;
}
.prose :global(.dripper-num) {
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 3rem;
	color: var(--color-border);
	line-height: 1;
	flex-shrink: 0;
}
.prose :global(.dripper-brand) {
	font-size: 0.65rem;
	letter-spacing: 0.3em;
	text-transform: uppercase;
	color: var(--color-accent-h);
	margin-bottom: 0.25rem;
}
.prose :global(.dripper-name) {
	font-family: var(--font-serif);
	font-size: 1.35rem;
	font-weight: 500;
	color: var(--color-text);
	letter-spacing: 0.05em;
	line-height: 1.3;
}
.prose :global(.dripper-name-en) {
	display: block;
	font-size: 0.72rem;
	color: var(--color-text-light);
	letter-spacing: 0.12em;
	margin-top: 0.2rem;
}
.prose :global(.use-badge) {
	margin-left: auto;
	flex-shrink: 0;
	align-self: center;
	background: var(--color-text);
	color: rgba(255,255,255,0.82);
	font-size: 0.65rem;
	letter-spacing: 0.12em;
	padding: 0.35em 0.85em;
	border-radius: var(--radius-sm);
	white-space: nowrap;
}
.prose :global(.dripper-body) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: 1.75rem 2rem;
	margin-bottom: 0.75rem;
	box-shadow: var(--shadow-sm);
}
