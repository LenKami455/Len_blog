---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`検索 | ${SITE_TITLE}`} description="記事を検索" />
	</head>
	<body>
		<Header />

		<div class="page-hero">
			<div class="page-hero-inner">
				<h1 class="page-hero-title">記事を検索</h1>
				<p class="page-hero-sub">タイトル・説明・タグで絞り込めます</p>
			</div>
		</div>

		<main class="search-main">
			<div class="search-box">
				<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
				<input
					id="search-input"
					type="search"
					placeholder="キーワードを入力..."
					autofocus
				/>
			</div>

			<p id="result-count" class="result-count" hidden></p>
			<p id="no-results" class="no-results" hidden>該当する記事が見つかりませんでした。</p>

			<ul id="results" class="results-list"></ul>
		</main>

		<Footer />

		<script>
			interface Post {
				id: string;
				title: string;
				description: string;
				tags: string[];
				category: string | null;
				pubDate: string;
				url: string;
			}

			let allPosts: Post[] = [];

			function fmt(iso: string) {
				return new Date(iso).toLocaleDateString('ja-JP', {
					year: 'numeric', month: 'long', day: 'numeric',
				});
			}

			async function loadPosts() {
				const res = await fetch('/search.json');
				allPosts = await res.json();
				renderResults(allPosts);
			}

			function normalize(s: string) { return s.toLowerCase(); }

			function search(query: string): Post[] {
				if (!query.trim()) return allPosts;
				const q = normalize(query);
				return allPosts.filter((p) =>
					normalize(p.title).includes(q) ||
					normalize(p.description).includes(q) ||
					p.tags.some((t) => normalize(t).includes(q)) ||
					(p.category && normalize(p.category).includes(q)),
				);
			}

			function highlight(text: string, query: string): string {
				if (!query.trim()) return text;
				const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
				return text.replace(re, '<mark>$1</mark>');
			}

			function renderResults(posts: Post[]) {
				const list   = document.getElementById('results') as HTMLUListElement;
				const noRes  = document.getElementById('no-results') as HTMLParagraphElement;
				const count  = document.getElementById('result-count') as HTMLParagraphElement;
				const input  = document.getElementById('search-input') as HTMLInputElement;
				const q      = input.value.trim();

				list.innerHTML = '';
				if (allPosts.length === 0) return;

				count.hidden = false;
				count.textContent = q ? `「${q}」の検索結果：${posts.length} 件` : `全 ${posts.length} 件`;

				if (posts.length === 0) { noRes.hidden = false; return; }
				noRes.hidden = true;

				for (const post of posts) {
					const tagsHtml = post.tags
						.map((t) => `<span class="tag-pill">#${t}</span>`)
						.join('');
					const li = document.createElement('li');
					li.className = 'result-card';
					li.innerHTML = `
						<a href="${post.url}">
							<div class="result-body">
								<p class="result-date">${fmt(post.pubDate)}</p>
								<h3 class="result-title">${highlight(post.title, q)}</h3>
								<p class="result-desc">${highlight(post.description, q)}</p>
								${tagsHtml ? `<div class="result-tags">${tagsHtml}</div>` : ''}
							</div>
							<span class="result-arrow">→</span>
						</a>
					`;
					list.appendChild(li);
				}
			}

			const input = document.getElementById('search-input') as HTMLInputElement;
			input.addEventListener('input', () => renderResults(search(input.value)));

			const q = new URLSearchParams(window.location.search).get('q');
			if (q) input.value = q;

			loadPosts().then(() => { if (q) renderResults(search(q)); });
		</script>
	</body>
</html>

<style>
.page-hero {
	background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
	border-bottom: 1px solid var(--color-border);
	padding: 3.5rem 0 3rem;
}
.page-hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.page-hero-title {
	font-family: var(--font-serif);
	font-size: 2.2rem;
	margin: 0 0 0.3rem;
}
.page-hero-sub { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }

.search-main {
	max-width: 780px;
	margin: 0 auto;
	padding: 3rem 2rem 5rem;
}

.search-box {
	position: relative;
	margin-bottom: 2rem;
}
.search-icon {
	position: absolute;
	left: 1rem;
	top: 50%;
	transform: translateY(-50%);
	color: var(--color-text-light);
	pointer-events: none;
}
#search-input {
	width: 100%;
	padding: 0.85em 1em 0.85em 2.8rem;
	font-size: 1rem;
	font-family: var(--font-sans);
	border: 2px solid var(--color-border);
	border-radius: var(--radius-md);
	background: var(--color-surface);
	color: var(--color-text);
	outline: none;
	transition: border-color .2s, box-shadow .2s;
	-webkit-appearance: none;
}
#search-input:focus {
	border-color: var(--color-accent);
	box-shadow: 0 0 0 3px var(--color-accent-bg);
}
#search-input::placeholder { color: var(--color-text-light); }

.result-count {
	font-size: 0.83rem;
	color: var(--color-text-muted);
	margin: 0 0 1.5rem;
	letter-spacing: 0.03em;
}
.no-results { color: var(--color-text-muted); font-size: 0.95rem; }

.results-list {
	list-style: none;
	margin: 0;
	padding: 0;
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
}
.result-card {
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	background: var(--color-surface);
	transition: box-shadow .2s, border-color .2s;
}
.result-card:hover { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
.result-card a {
	display: flex;
	align-items: center;
	gap: 1rem;
	padding: 1.2rem 1.5rem;
	text-decoration: none;
	color: inherit;
}
.result-body { flex: 1; min-width: 0; }
.result-date { font-size: 0.75rem; color: var(--color-text-light); margin: 0 0 0.3rem; letter-spacing: 0.06em; }
.result-title { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.4rem; line-height: 1.4; }
.result-card:hover .result-title { color: var(--color-accent); }
.result-desc { font-size: 0.85rem; color: var(--color-text-muted); margin: 0 0 0.6rem; line-height: 1.6; }
.result-tags { display: flex; flex-wrap: wrap; gap: 0.35em; }
.result-arrow { color: var(--color-accent); flex-shrink: 0; font-size: 1.1rem; transition: transform .2s; }
.result-card:hover .result-arrow { transform: translateX(3px); }

:global(mark) {
	background: #FFF3C4;
	color: inherit;
	border-radius: 2px;
	padding: 0 2px;
}

@media (max-width: 600px) {
	.search-main { padding: 2rem 1rem 3rem; }
}
</style>
