---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');

const posts = allPosts
	.filter(p => p.data.category !== 'フォトログ')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 7);

const latestPhotolog = allPosts
	.filter(p => p.data.category === 'フォトログ')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 1)[0];

// ヒーロースライダー用：featured記事を優先、足りなければ最新で補完（heroImageあり、最大6件）
const featuredPosts = allPosts
	.filter(p => p.data.heroImage && p.data.featured)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fallbackPosts = allPosts
	.filter(p => p.data.heroImage && !p.data.featured)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const heroSlides = [...featuredPosts, ...fallbackPosts].slice(0, 6);

const categories = [
	{
		name: '旅行',
		slug: '旅行',
		icon: '✈',
		logo: '/Plane_logo.png',
		desc: '国内外の旅の記録。出会った景色、食べたもの、感じたこと。',
	},
	{
		name: 'コーヒー',
		slug: 'コーヒー',
		icon: '☕',
		logo: '/CoffeeCup_logo.png',
		desc: 'スペシャルティコーヒーの魅力、豆選び、淹れ方のあれこれ。',
	},
	{
		name: 'ガジェット',
		slug: 'ガジェット',
		icon: '📦',
		logo: '/Gaget_logo.png',
		desc: '買ってよかったもの、気になるガジェット、暮らしを彩るアイテム。',
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- ── Hero Slider ──────────────────────────────── -->
		<section class="hero-slider" aria-roledescription="carousel" aria-label="最新の記事">
			<div class="slider-track" id="sliderTrack">
				{heroSlides.map((post, i) => (
					<div class="slide" data-index={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${heroSlides.length}`}>
						{post.data.heroImage && (
							<div class="slide-bg" style={`background-image: url('${post.data.heroImage}')`}></div>
						)}
						<div class="slide-overlay"></div>
						<div class="slide-content">
							<a href={`/blog/${post.id}/`} class="slide-link">
								<h2 class="slide-title">{post.data.title}</h2>
								<span class="slide-cta" aria-hidden="true">→</span>
							</a>
						</div>
					</div>
				))}
			</div>

			<button class="slider-arrow slider-prev" id="sliderPrev" aria-label="前のスライド">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
			</button>
			<button class="slider-arrow slider-next" id="sliderNext" aria-label="次のスライド">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
			</button>

			<div class="slider-dots" id="sliderDots" role="tablist">
				{heroSlides.map((_, i) => (
					<button class={`slider-dot ${i === 0 ? 'is-active' : ''}`} data-index={i} aria-label={`スライド ${i + 1} へ`}></button>
				))}
			</div>

			<div class="slider-scroll-hint" aria-hidden="true">
				<span class="ssh-text">Scroll</span>
				<span class="ssh-dot"></span>
			</div>
		</section>

		<!-- ── Categories ───────────────────────────────── -->
		<section class="categories-section">
			<div class="section-inner">
				<h2 class="section-label reveal">カテゴリ</h2>
				<ul class="categories-grid">
					{categories.map((cat) => (
						<li class="reveal">
							<a href={`/tags/${cat.slug}/`} class="cat-card">
								<span class="cat-icon"><img src={cat.logo} alt={cat.name} class="cat-logo" /></span>
								<span class="cat-name">{cat.name}</span>
								<span class="cat-desc">{cat.desc}</span>
								<span class="cat-arrow">→</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- ── Photolog Banner ──────────────────────────────── -->
		<section class="photolog-section">
			<div class="section-inner">
			<a href="/photolog" class="photolog-banner reveal">
				{latestPhotolog?.data.heroImage && (
					<div class="photolog-bg" style={`background-image: url('${latestPhotolog.data.heroImage}')`}></div>
				)}
				<div class="photolog-overlay"></div>
				<div class="photolog-inner">
					<img src="/Camera_logo.png" alt="" class="photolog-camera-icon" />
					<p class="photolog-eyebrow">photo log</p>
					<p class="photolog-title">photolog.</p>
					<p class="photolog-desc">カメラを持って歩いた記録。</p>
					<span class="photolog-cta">見る →</span>
				</div>
			</a>
			</div>
		</section>

		<!-- ── Latest Posts ──────────────────────────────── -->
		<section class="posts-section">
			<div class="section-inner">
				<div class="section-header reveal">
					<h2 class="section-label">最近の記事</h2>
					<a href="/blog" class="section-more">すべて見る →</a>
				</div>
				<ul class="posts-grid">
					{posts.map((post, i) => (
						<li class={`post-card reveal ${i === 0 ? 'post-card--featured' : ''}`}>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="card-img">
										<Image
											width={i === 0 ? 800 : 400}
											height={i === 0 ? 420 : 220}
											src={post.data.heroImage}
											alt={post.data.title}
											transition:name={`hero-${post.id}`}
										/>
									</div>
								)}
								<div class="card-body">
									<h3 class="card-title">{post.data.title}</h3>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
/* ── Hero Slider ────────────────────────────── */
.hero-slider {
	position: relative;
	overflow: hidden;
	height: clamp(480px, 70vh, 760px);
	background: #1a1a1a;
}

.slider-track {
	display: flex;
	width: 100%;
	height: 100%;
	transition: transform 1.2s cubic-bezier(0.4, 0.0, 0.2, 1);
	will-change: transform;
}

.slide {
	position: relative;
	flex: 0 0 100%;
	height: 100%;
	overflow: hidden;
}
.slide-bg {
	position: absolute;
	inset: 0;
	background-size: cover;
	background-position: center;
	transform: scale(1.05);
	transition: transform 7s ease-out;
}
.slide[data-active="true"] .slide-bg {
	transform: scale(1);
}
.slide-overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(to right,
		rgba(0,0,0,0.62) 0%,
		rgba(0,0,0,0.38) 45%,
		rgba(0,0,0,0.22) 100%),
	linear-gradient(to bottom,
		rgba(0,0,0,0.15) 0%,
		rgba(0,0,0,0.1) 40%,
		rgba(0,0,0,0.5) 100%);
}
.slide-content {
	position: relative;
	z-index: 2;
	max-width: 1100px;
	height: 100%;
	margin: 0 auto;
	/* 矢印（48px）+ 配置(1rem) と干渉しないよう左右パディング広め */
	padding: 0 5.5rem;
	display: flex;
	flex-direction: column;
	justify-content: center;
	color: #fff;
}
.slide-link {
	display: inline-flex;
	align-items: baseline;
	gap: 0.9rem;
	text-decoration: none;
	max-width: 720px;
}
.slide-title {
	font-family: 'Hannari', 'Noto Serif JP', serif;
	font-weight: 400;
	font-size: clamp(1.8rem, 4.2vw, 3rem);
	line-height: 1.4;
	margin: 0;
	letter-spacing: 0.03em;
	color: #fff;
	text-shadow: 0 2px 20px rgba(0,0,0,0.6), 0 1px 3px rgba(0,0,0,0.4);
	opacity: 0;
	transform: translateY(12px);
	transition: opacity .9s ease .4s, transform .9s ease .4s;
}
.slide-cta {
	flex-shrink: 0;
	color: rgba(255,255,255,0.75);
	font-size: var(--fs-lg);
	line-height: 1;
	transition: color .2s, transform .25s;
	opacity: 0;
	transform: translateY(12px);
	transition-property: opacity, transform, color;
	transition-duration: .9s, .9s, .25s;
	transition-delay: .55s, .55s, 0s;
}
.slide-link:hover .slide-cta {
	color: #fff;
	transform: translateX(4px);
}

/* アクティブスライドの中身をフェードイン */
.slide[data-active="true"] .slide-title,
.slide[data-active="true"] .slide-cta {
	opacity: 1;
	transform: translateY(0);
}
.slide[data-active="true"] .slide-link:hover .slide-cta {
	transform: translateX(4px);
}

/* ── Arrows ─────────────────────── */
.slider-arrow {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	z-index: 3;
	width: 48px;
	height: 48px;
	background: rgba(0,0,0,0.15);
	border: 1px solid rgba(255,255,255,0.35);
	border-radius: 50%;
	color: rgba(255,255,255,0.85);
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background .2s, color .2s, border-color .2s;
	backdrop-filter: blur(4px);
}
.slider-arrow:hover {
	background: rgba(0,0,0,0.5);
	color: #fff;
	border-color: rgba(255,255,255,0.7);
}
.slider-prev { left: 1rem; }
.slider-next { right: 1rem; }

/* ── Dots ─────────────────────── */
.slider-dots {
	position: absolute;
	bottom: 2.5rem;
	left: 0;
	right: 0;
	display: flex;
	justify-content: center;
	gap: 0.55rem;
	z-index: 3;
}
.slider-dot {
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: rgba(255,255,255,0.35);
	border: none;
	padding: 0;
	cursor: pointer;
	transition: background .25s, width .35s, border-radius .35s;
}
.slider-dot:hover { background: rgba(255,255,255,0.6); }
.slider-dot.is-active {
	background: #fff;
	width: 24px;
	border-radius: 4px;
}

/* ── Scroll hint ─────────────────────── */
.slider-scroll-hint {
	position: absolute;
	bottom: 0.6rem;
	left: 50%;
	transform: translateX(-50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.4rem;
	color: rgba(255,255,255,0.55);
	z-index: 3;
}
.ssh-text {
	font-family: 'BIZ UDPGothic', sans-serif;
	font-size: 0.6rem;
	letter-spacing: 0.35em;
	text-transform: uppercase;
}
.ssh-dot {
	display: block;
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: rgba(255,255,255,0.6);
	animation: sshBounce 2s ease-in-out infinite;
}
@keyframes sshBounce {
	0%, 100% { transform: translateY(0); opacity: 0.4; }
	50%      { transform: translateY(4px); opacity: 1; }
}

/* ── Responsive ─────────────────────── */
@media (max-width: 768px) {
	.hero-slider { height: clamp(420px, 60vh, 600px); }
	/* 矢印（38px）+ 配置(0.75rem) と被らないよう左右パディングを広く取る */
	.slide-content { padding: 0 3.5rem; }
	.slide-title { font-size: clamp(1.5rem, 6vw, 2.1rem); }
	.slide-cta { font-size: var(--fs-md); }
	.slider-arrow { width: 38px; height: 38px; }
	.slider-prev { left: 0.5rem; }
	.slider-next { right: 0.5rem; }
	/* ドットを上に、SCROLLヒントと被らないように */
	.slider-dots { bottom: 3.25rem; }
	.slider-scroll-hint { bottom: 0.75rem; }
}
@media (max-width: 480px) {
	/* 小さいスマホでは矢印を半透明＆さらに左右パディング確保 */
	.slide-content { padding: 0 3rem; }
	.slider-arrow {
		width: 32px;
		height: 32px;
		background: rgba(0,0,0,0.25);
		border-color: rgba(255,255,255,0.3);
	}
	.slider-prev { left: 0.3rem; }
	.slider-next { right: 0.3rem; }
	.slider-dots { bottom: 3rem; }
}

/* ── Section commons ───────────────────────────── */
.section-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.section-header {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 1.75rem;
}
.section-label {
	font-family: var(--font-serif);
	font-size: var(--fs-lg);
	font-weight: 700;
	color: var(--color-text);
	margin: 0;
	position: relative;
	padding-left: 0.9rem;
}
.section-label::before {
	content: '';
	position: absolute;
	left: 0; top: 0.1em; bottom: 0.1em;
	width: 3px;
	background: var(--color-accent);
	border-radius: 2px;
}
.section-more {
	font-size: var(--fs-sm);
	color: var(--color-text-muted);
	text-decoration: none;
	transition: color .2s;
}
.section-more:hover { color: var(--color-accent); }

/* ── Categories ─────────────────────────────────── */
.categories-section {
	padding: var(--sp-8) 0;
	border-bottom: 1px solid var(--color-border);
}
.categories-grid {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
}
.cat-card {
	display: grid;
	grid-template-columns: auto 1fr auto;
	grid-template-rows: auto auto;
	gap: 0.2rem 0.75rem;
	align-items: start;
	padding: 1.4rem 1.5rem;
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	text-decoration: none;
	transition: box-shadow .2s, border-color .2s, transform .2s;
}
.cat-card:hover {
	border-color: var(--color-accent);
	box-shadow: var(--shadow-md);
	transform: translateY(-2px);
}
.cat-icon {
	grid-row: 1;
	grid-column: 1;
	font-size: var(--fs-xl);
	line-height: 1;
}
.cat-logo {
	width: 36px;
	height: 36px;
	object-fit: contain;
	opacity: 0.72;
	transition: opacity .2s;
}
.cat-card:hover .cat-logo {
	opacity: 1;
}
.cat-name {
	grid-row: 1;
	grid-column: 2;
	font-family: var(--font-serif);
	font-size: var(--fs-md);
	font-weight: 700;
	color: var(--color-text);
	align-self: center;
}
.cat-arrow {
	grid-row: 1;
	grid-column: 3;
	font-size: var(--fs-base);
	color: var(--color-accent);
	align-self: center;
	transition: transform .2s;
}
.cat-card:hover .cat-arrow { transform: translateX(3px); }
.cat-desc {
	grid-row: 2;
	grid-column: 1 / -1;
	font-size: var(--fs-sm);
	color: var(--color-text-muted);
	line-height: 1.6;
	margin-top: 0.4rem;
}

/* ── Photolog Banner ────────────────────────────── */
.photolog-section {
	padding: var(--sp-8) 0;
}
.photolog-banner {
	display: block;
	position: relative;
	text-decoration: none;
	overflow: hidden;
	height: 260px;
	border-radius: var(--radius-lg);
}
.photolog-bg {
	position: absolute;
	inset: 0;
	background-size: cover;
	background-position: center;
	transition: transform .6s ease;
}
.photolog-banner:hover .photolog-bg {
	transform: scale(1.03);
}
.photolog-overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(to right, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.25) 60%, transparent 100%);
}
.photolog-inner {
	position: relative;
	z-index: 1;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	padding: 0 2.5rem;
}
.photolog-camera-icon {
	width: 44px;
	height: 44px;
	object-fit: contain;
	opacity: 0.6;
	margin-bottom: 1rem;
	filter: brightness(0) invert(1);
}
.photolog-eyebrow {
	font-family: 'Georgia', serif;
	font-size: var(--fs-2xs);
	letter-spacing: 0.5em;
	text-transform: uppercase;
	color: rgba(255,255,255,0.55);
	margin: 0 0 0.5rem;
}
.photolog-title {
	font-family: 'Georgia', serif;
	font-style: italic;
	font-weight: 300;
	font-size: clamp(2rem, 4vw, 3rem);
	color: #fff;
	margin: 0 0 0.6rem;
	letter-spacing: -0.01em;
	line-height: 1;
}
.photolog-desc {
	font-size: var(--fs-sm);
	color: rgba(255,255,255,0.72);
	margin: 0 0 1.25rem;
	letter-spacing: 0.08em;
}
.photolog-cta {
	font-size: var(--fs-sm);
	color: rgba(255,255,255,0.85);
	letter-spacing: 0.12em;
	border-bottom: 1px solid rgba(255,255,255,0.4);
	padding-bottom: 2px;
	align-self: flex-start;
	transition: color .2s, border-color .2s;
}
.photolog-banner:hover .photolog-cta {
	color: #fff;
	border-color: rgba(255,255,255,0.8);
}

@media (max-width: 640px) {
	.photolog-banner { height: 200px; }
	.photolog-inner { padding: 0 1.5rem; }
}

/* ── Posts ─────────────────────────────────────── */
.posts-section { padding: var(--sp-8) 0; }
.posts-grid {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.5rem;
}
.post-card--featured {
	grid-column: 1 / -1;
	display: grid;
	grid-template-columns: 1.4fr 1fr;
}
.post-card--featured .card-img img {
	height: 320px !important;
	border-radius: var(--radius-lg) 0 0 var(--radius-lg) !important;
}
.post-card--featured .card-body {
	display: flex;
	flex-direction: column;
	justify-content: center;
	padding: 2rem 2.5rem !important;
}
.post-card--featured .card-title {
	font-size: var(--fs-xl) !important;
	margin-bottom: 0.8rem !important;
}

.post-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: box-shadow .25s, transform .25s; }
.post-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.post-card a { display: block; text-decoration: none; color: inherit; height: 100%; }
.post-card--featured > a {
	display: contents;
}
.card-img img { width: 100%; height: 200px; object-fit: cover; display: block; filter: saturate(0.82); transition: transform .4s, filter .4s; border-radius: 0; }
.post-card:hover .card-img img { transform: scale(1.03); filter: saturate(1); }
.card-body { padding: 1.2rem 1.4rem 1.4rem; }
.card-title { font-family: var(--font-serif); font-size: var(--fs-md); font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.5; }
.post-card:hover .card-title { color: var(--color-accent); }

@media (max-width: 900px) {
	.categories-grid { grid-template-columns: 1fr; gap: 0.75rem; }
	.posts-grid { grid-template-columns: 1fr 1fr; }
	.post-card--featured { grid-column: 1 / -1; grid-template-columns: 1fr; }
	.post-card--featured .card-img img { height: 220px !important; border-radius: var(--radius-lg) var(--radius-lg) 0 0 !important; }
	.post-card--featured .card-body { padding: 1.4rem !important; }
	.post-card--featured .card-title { font-size: var(--fs-lg) !important; }
	.cat-card { grid-template-columns: auto 1fr auto; }
}
@media (max-width: 640px) {
	.section-inner { padding: 0 1rem; }
	.posts-grid { grid-template-columns: 1fr; }
	.br-md { display: none; }
}
</style>

<script>
// ── Hero Slider（View Transitions 対応：遷移ごとに再初期化） ──
let sliderTimer: ReturnType<typeof setInterval> | null = null;

function stopSliderTimer() {
	if (sliderTimer) { clearInterval(sliderTimer); sliderTimer = null; }
}

function initHeroSlider() {
	stopSliderTimer();
	const track = document.getElementById('sliderTrack');
	const prev = document.getElementById('sliderPrev');
	const next = document.getElementById('sliderNext');
	const dotsWrap = document.getElementById('sliderDots');
	if (!track || !prev || !next || !dotsWrap) return;

	const slides = Array.from(track.querySelectorAll('.slide'));
	const dots = Array.from(dotsWrap.querySelectorAll('.slider-dot'));
	if (slides.length <= 1) return;

	let current = 0;
	const AUTO_MS = 6000;

	function update(i: number) {
		current = (i + slides.length) % slides.length;
		track.style.transform = `translateX(-${current * 100}%)`;
		slides.forEach((s, idx) => s.setAttribute('data-active', String(idx === current)));
		dots.forEach((d, idx) => d.classList.toggle('is-active', idx === current));
	}

	function play() {
		stopSliderTimer();
		sliderTimer = setInterval(() => update(current + 1), AUTO_MS);
	}
	function restart() { stopSliderTimer(); play(); }

	prev.addEventListener('click', () => { update(current - 1); restart(); });
	next.addEventListener('click', () => { update(current + 1); restart(); });
	dots.forEach((d, i) => d.addEventListener('click', () => { update(i); restart(); }));

	// ホバー中は止める
	const slider = track.closest('.hero-slider');
	if (slider) {
		slider.addEventListener('mouseenter', stopSliderTimer);
		slider.addEventListener('mouseleave', play);
	}

	// 初期化
	update(0);
	play();
}

initHeroSlider();
document.addEventListener('astro:page-load', initHeroSlider);
document.addEventListener('astro:before-swap', stopSliderTimer);
</script>
