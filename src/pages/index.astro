---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const categories = [
	{
		name: '旅行',
		slug: '旅行',
		icon: '✈',
		desc: '国内外の旅の記録。出会った景色、食べたもの、感じたこと。',
	},
	{
		name: 'コーヒー',
		slug: 'コーヒー',
		icon: '☕',
		desc: 'スペシャルティコーヒーの魅力、豆選び、淹れ方のあれこれ。',
	},
	{
		name: 'ガジェット',
		slug: 'ガジェット',
		icon: '📦',
		desc: '買ってよかったもの、気になるガジェット、暮らしを彩るアイテム。',
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- ── Hero ─────────────────────────────────────── -->
		<section class="hero">
			<div class="hero-inner">
				<p class="hero-eyebrow">welcome</p>
				<!-- 撮影地ラベル -->
				<p class="hero-location" aria-label="撮影地: Cebu City, Philippines">
					<span class="hero-location-pin">
						<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 13-8 13S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
					</span>
					<span>Cebu City, Philippines</span>
				</p>
				<h1 class="hero-title">
					<span class="tk">旅</span><span class="th">と</span><span class="tk">写真</span><span class="th">と</span><span class="tk">コーヒー</span><span class="th">と</span><span class="tdot">。</span>
				</h1>
				<p class="hero-lead">
					旅の途中で見つけた景色、一杯のコーヒーが運ぶ香り、<br class="br-md" />
					気になるガジェットや買ってよかったもの。<br />
					日々の「好き」をゆっくり綴ります。
				</p>
				<div class="hero-actions">
					<a href="/blog" class="btn-primary">記事を読む</a>
					<a href="/about" class="btn-secondary">About</a>
				</div>
			</div>
		</section>

		<!-- ── Categories ───────────────────────────────── -->
		<section class="categories-section">
			<div class="section-inner">
				<h2 class="section-label">カテゴリ</h2>
				<ul class="categories-grid">
					{categories.map((cat) => (
						<li>
							<a href={`/tags/${cat.slug}/`} class="cat-card">
								<span class="cat-icon">{cat.icon}</span>
								<span class="cat-name">{cat.name}</span>
								<span class="cat-desc">{cat.desc}</span>
								<span class="cat-arrow">→</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- ── Latest Posts ──────────────────────────────── -->
		<section class="posts-section">
			<div class="section-inner">
				<div class="section-header">
					<h2 class="section-label">最近の記事</h2>
					<a href="/blog" class="section-more">すべて見る →</a>
				</div>
				<ul class="posts-grid">
					{posts.map((post, i) => (
						<li class={`post-card ${i === 0 ? 'post-card--featured' : ''}`}>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="card-img">
										<Image
											width={i === 0 ? 800 : 400}
											height={i === 0 ? 420 : 220}
											src={post.data.heroImage}
											alt={post.data.title}
										/>
									</div>
								)}
								<div class="card-body">
									<p class="card-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<div class="card-tags">
											{post.data.tags.map((tag) => (
												<span class="tag-pill">#{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
/* ── Hero（写真背景） ────────────────────────────── */
.hero {
	position: relative;
	overflow: hidden;   /* ← ここでクリップ */
	min-height: clamp(480px, 70vh, 760px);
	display: flex;
	align-items: center;
}

/*
  ::before を上下にはみ出させ、overflow:hidden でカット。
    top: -20/70 * 100% = -28.57%  → 画像上部20%を隠す
    bottom: -10/70 * 100% = -14.29% → 画像下部10%を隠す
*/
.hero::before {
	content: '';
	position: absolute;
	top: -28.57%;
	bottom: -14.29%;
	left: 0;
	right: 0;
	background:
		linear-gradient(to bottom,
			rgba(0,0,0,0.38) 0%,
			rgba(0,0,0,0.22) 50%,
			rgba(0,0,0,0.52) 100%),
		url('/images/hero/A7C00530.jpg') center / cover no-repeat;
	z-index: 0;
}

.hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 6rem 2rem 5rem;
	position: relative;
	z-index: 1;
	width: 100%;
}
.hero-eyebrow {
	font-size: 0.75rem;
	letter-spacing: 0.3em;
	text-transform: uppercase;
	color: rgba(255,255,255,0.7);
	margin: 0 0 1rem;
}

/* 撮影地ラベル（右下） */
.hero-location {
	position: absolute;
	bottom: 1.4rem;
	right: 1.8rem;
	display: inline-flex;
	align-items: center;
	gap: 0.35em;
	font-family: 'Georgia', serif;
	font-style: italic;
	font-size: 0.72rem;
	letter-spacing: 0.12em;
	color: rgba(255,255,255,0.45);
	margin: 0;
	transition: color .3s;
	z-index: 2;
}
.hero-location:hover {
	color: rgba(255,255,255,0.75);
}
.hero-location-pin {
	display: flex;
	align-items: center;
	opacity: 0.7;
}
.hero-title {
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 0;
	font-size: clamp(2.2rem, 5.5vw, 4rem);
	margin: 0 0 1.4rem;
	line-height: 1.3;
	/* テキストシャドウで写真に馴染ませる */
	filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
}
/* 漢字・カタカナ：はんなり明朝（白） */
.tk {
	font-family: 'Hannari', 'Noto Serif JP', serif;
	font-weight: 400;
	color: #ffffff;
	letter-spacing: 0.04em;
}
/* ひらがな：UD角ゴシック、小さめ（白） */
.th {
	font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
	font-size: 0.62em;
	font-weight: 400;
	color: rgba(255,255,255,0.9);
	letter-spacing: 0.02em;
	position: relative;
	top: -0.08em;
}
.tdot {
	font-family: 'Hannari', 'Noto Serif JP', serif;
	font-weight: 400;
	color: #ffffff;
	letter-spacing: 0;
}
.hero-lead {
	font-size: clamp(0.9rem, 1.8vw, 1.05rem);
	color: rgba(255,255,255,0.82);
	margin: 0 0 2.5rem;
	line-height: 2.1;
	max-width: 520px;
	text-shadow: 0 1px 6px rgba(0,0,0,0.5);
}
.hero-actions {
	display: flex;
	gap: 1rem;
	flex-wrap: wrap;
}
.btn-primary {
	display: inline-block;
	padding: 0.7em 1.8em;
	background: rgba(255,255,255,0.18);
	border: 1.5px solid rgba(255,255,255,0.6);
	color: #fff;
	border-radius: var(--radius-md);
	font-size: 0.9rem;
	font-weight: 700;
	letter-spacing: 0.06em;
	text-decoration: none;
	backdrop-filter: blur(4px);
	transition: background .2s, border-color .2s;
}
.btn-primary:hover {
	background: rgba(255,255,255,0.3);
	color: #fff;
	border-color: #fff;
}
.btn-secondary {
	display: inline-block;
	padding: 0.7em 1.6em;
	border: 1.5px solid rgba(255,255,255,0.35);
	color: rgba(255,255,255,0.8);
	border-radius: var(--radius-md);
	font-size: 0.9rem;
	letter-spacing: 0.04em;
	text-decoration: none;
	transition: border-color .2s, color .2s;
}
.btn-secondary:hover {
	border-color: rgba(255,255,255,0.8);
	color: #fff;
}

/* ── Section commons ───────────────────────────── */
.section-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.section-header {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 1.75rem;
}
.section-label {
	font-family: var(--font-serif);
	font-size: 1.3rem;
	font-weight: 700;
	color: var(--color-text);
	margin: 0;
	position: relative;
	padding-left: 0.9rem;
}
.section-label::before {
	content: '';
	position: absolute;
	left: 0; top: 0.1em; bottom: 0.1em;
	width: 3px;
	background: var(--color-accent);
	border-radius: 2px;
}
.section-more {
	font-size: 0.85rem;
	color: var(--color-text-muted);
	text-decoration: none;
	transition: color .2s;
}
.section-more:hover { color: var(--color-accent); }

/* ── Categories ─────────────────────────────────── */
.categories-section {
	padding: 4rem 0;
	border-bottom: 1px solid var(--color-border);
}
.categories-grid {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
}
.cat-card {
	display: grid;
	grid-template-columns: auto 1fr auto;
	grid-template-rows: auto auto;
	gap: 0.2rem 0.75rem;
	align-items: start;
	padding: 1.4rem 1.5rem;
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	text-decoration: none;
	transition: box-shadow .2s, border-color .2s, transform .2s;
}
.cat-card:hover {
	border-color: var(--color-accent);
	box-shadow: var(--shadow-md);
	transform: translateY(-2px);
}
.cat-icon {
	grid-row: 1;
	grid-column: 1;
	font-size: 1.6rem;
	line-height: 1;
}
.cat-name {
	grid-row: 1;
	grid-column: 2;
	font-family: var(--font-serif);
	font-size: 1rem;
	font-weight: 700;
	color: var(--color-text);
	align-self: center;
}
.cat-arrow {
	grid-row: 1;
	grid-column: 3;
	font-size: 0.9rem;
	color: var(--color-accent);
	align-self: center;
	transition: transform .2s;
}
.cat-card:hover .cat-arrow { transform: translateX(3px); }
.cat-desc {
	grid-row: 2;
	grid-column: 1 / -1;
	font-size: 0.82rem;
	color: var(--color-text-muted);
	line-height: 1.6;
	margin-top: 0.4rem;
}

/* ── Posts ─────────────────────────────────────── */
.posts-section { padding: 4rem 0; }
.posts-grid {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.5rem;
}
.post-card--featured {
	grid-column: 1 / -1;
	display: grid;
	grid-template-columns: 1.4fr 1fr;
}
.post-card--featured .card-img img {
	height: 320px !important;
	border-radius: var(--radius-lg) 0 0 var(--radius-lg) !important;
}
.post-card--featured .card-body {
	display: flex;
	flex-direction: column;
	justify-content: center;
	padding: 2rem 2.5rem !important;
}
.post-card--featured .card-title {
	font-size: 1.45rem !important;
	margin-bottom: 0.8rem !important;
}
.post-card--featured .card-desc { display: block !important; }

.post-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: box-shadow .25s, transform .25s; }
.post-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.post-card a { display: block; text-decoration: none; color: inherit; height: 100%; }
.post-card--featured > a {
	display: contents;
}
.card-img img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform .4s; border-radius: 0; }
.post-card:hover .card-img img { transform: scale(1.03); }
.card-body { padding: 1.2rem 1.4rem 1.4rem; }
.card-date { font-size: 0.75rem; color: var(--color-text-light); letter-spacing: 0.06em; margin: 0 0 0.4rem; }
.card-title { font-family: var(--font-serif); font-size: 1rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.5; }
.post-card:hover .card-title { color: var(--color-accent); }
.card-desc { font-size: 0.82rem; color: var(--color-text-muted); margin: 0 0 0.75rem; line-height: 1.6; display: none; }
.card-tags { display: flex; flex-wrap: wrap; gap: 0.35em; }

@media (max-width: 900px) {
	.categories-grid { grid-template-columns: 1fr; gap: 0.75rem; }
	.posts-grid { grid-template-columns: 1fr 1fr; }
	.post-card--featured { grid-column: 1 / -1; grid-template-columns: 1fr; }
	.post-card--featured .card-img img { height: 220px !important; border-radius: var(--radius-lg) var(--radius-lg) 0 0 !important; }
	.post-card--featured .card-body { padding: 1.4rem !important; }
	.post-card--featured .card-title { font-size: 1.2rem !important; }
	.cat-card { grid-template-columns: auto 1fr auto; }
}
@media (max-width: 640px) {
	.hero-inner { padding: 4rem 1rem 3.5rem; }
	.section-inner { padding: 0 1rem; }
	.posts-grid { grid-template-columns: 1fr; }
	.br-md { display: none; }
}
</style>
