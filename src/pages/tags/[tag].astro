---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagSet = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags) tagSet.add(tag);
	}
	return [...tagSet].map((tag) => ({
		params: { tag },
		props: {
			posts: posts
				.filter((p) => p.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`タグ「${tag}」の記事 ${posts.length} 件`} />
	</head>
	<body>
		<Header />

		<div class="page-hero">
			<div class="page-hero-inner">
				<a href="/tags/" class="breadcrumb">タグ一覧 /</a>
				<h1 class="page-hero-title">#{tag}</h1>
				<p class="page-hero-sub">{posts.length} 件の記事</p>
			</div>
		</div>

		<main class="tag-main">
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-card">
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<div class="card-img">
									<Image width={480} height={240} src={post.data.heroImage} alt={post.data.title} />
								</div>
							)}
							<div class="card-body">
								<h2 class="card-title">{post.data.title}</h2>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>

		<Footer />
	</body>
</html>

<style>
.page-hero {
	background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
	border-bottom: 1px solid var(--color-border);
	padding: 3.5rem 0 3rem;
}
.page-hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.breadcrumb {
	font-size: 0.8rem;
	color: var(--color-text-muted);
	text-decoration: none;
	display: block;
	margin-bottom: 0.5rem;
	transition: color .2s;
}
.breadcrumb:hover { color: var(--color-accent); }
.page-hero-title {
	font-family: var(--font-serif);
	font-size: 2.2rem;
	margin: 0 0 0.3rem;
}
.page-hero-sub {
	font-size: 0.85rem;
	color: var(--color-text-muted);
	margin: 0;
}

.tag-main {
	max-width: 1100px;
	margin: 0 auto;
	padding: 3rem 2rem 5rem;
}
.post-list {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.5rem;
}
.post-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	overflow: hidden;
	transition: box-shadow .25s, transform .25s;
}
.post-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.post-card > a { display: block; text-decoration: none; color: inherit; height: 100%; }
.card-img { overflow: hidden; }
.card-img img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform .4s; border-radius: 0; }
.post-card:hover .card-img img { transform: scale(1.04); }
.card-body { padding: 1.2rem 1.4rem 1.5rem; }
.card-date { font-size: 0.75rem; color: var(--color-text-light); letter-spacing: 0.06em; margin: 0 0 0.4rem; }
.card-title { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.5; }
.post-card:hover .card-title { color: var(--color-accent); }
.card-desc { font-size: 0.83rem; color: var(--color-text-muted); margin: 0 0 0.75rem; line-height: 1.7; }
.card-tags { display: flex; flex-wrap: wrap; gap: 0.35em; }
.tag-pill--active {
	background: var(--color-accent) !important;
	color: #fff !important;
}

@media (max-width: 900px) { .post-list { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) {
	.tag-main { padding: 2rem 1rem 3rem; }
	.post-list { grid-template-columns: 1fr; }
}
</style>
