---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`タグ一覧 | ${SITE_TITLE}`} description="記事のタグ一覧" />
	</head>
	<body>
		<Header />

		<div class="page-hero">
			<div class="page-hero-inner">
				<h1 class="page-hero-title">タグ一覧</h1>
				<p class="page-hero-sub">{tags.length} 件のタグ</p>
			</div>
		</div>

		<main class="tags-main">
			{tags.length === 0 ? (
				<p class="empty">タグがまだありません。</p>
			) : (
				<ul class="tag-cloud">
					{tags.map(([tag, count]) => (
						<li>
							<a href={`/tags/${tag}/`} class="tag-item" data-count={count}>
								<span class="tag-name">#{tag}</span>
								<span class="tag-count">{count}</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>

		<Footer />
	</body>
</html>

<style>
.page-hero {
	background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
	border-bottom: 1px solid var(--color-border);
	padding: 3.5rem 0 3rem;
}
.page-hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.page-hero-title {
	font-family: var(--font-serif);
	font-size: 2.2rem;
	margin: 0 0 0.3rem;
}
.page-hero-sub {
	font-size: 0.85rem;
	color: var(--color-text-muted);
	margin: 0;
	letter-spacing: 0.05em;
}

.tags-main {
	max-width: 1100px;
	margin: 0 auto;
	padding: 3rem 2rem 5rem;
}

.tag-cloud {
	list-style: none;
	margin: 0;
	padding: 0;
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem;
}

.tag-item {
	display: inline-flex;
	align-items: center;
	gap: 0.5em;
	padding: 0.45em 1.1em;
	background: var(--color-surface);
	border: 1.5px solid var(--color-border);
	border-radius: var(--radius-md);
	text-decoration: none;
	color: var(--color-text);
	font-size: 0.9rem;
	transition: border-color .2s, background .2s, transform .2s;
}
.tag-item:hover {
	border-color: var(--color-accent);
	background: var(--color-accent-bg);
	color: var(--color-accent);
	transform: translateY(-1px);
}
.tag-name { font-family: var(--font-serif); font-weight: 700; }
.tag-count {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 1.5em;
	height: 1.5em;
	background: var(--color-bg-alt);
	border-radius: 999px;
	font-size: 0.72rem;
	color: var(--color-text-muted);
	font-family: var(--font-sans);
	font-weight: 700;
}
.tag-item:hover .tag-count {
	background: var(--color-accent);
	color: #fff;
}

.empty { color: var(--color-text-muted); }

@media (max-width: 600px) {
	.tags-main { padding: 2rem 1rem 3rem; }
}
</style>
