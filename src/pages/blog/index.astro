---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter(p => p.data.category !== 'フォトログ')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description="すべての記事一覧" />
	</head>
	<body>
		<Header />

		<div class="page-hero">
			<div class="page-hero-inner">
				<h1 class="page-hero-title">記事一覧</h1>
				<p class="page-hero-sub">{posts.length} 件の記事</p>
			</div>
		</div>

		<main class="blog-main">
			<ul class="post-list">
				{posts.map((post, i) => (
					<li class={`post-card reveal ${i === 0 ? 'post-card--hero' : ''}`}>
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<div class="card-img">
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										loading="lazy"
										transition:name={`hero-${post.id}`}
									/>
								</div>
							)}
							<div class="card-body">
								<p class="card-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2 class="card-title">{post.data.title}</h2>
								<p class="card-desc">{post.data.description}</p>
								{post.data.tags.length > 0 && (
									<div class="card-tags">
										{post.data.tags.map((tag) => (
											<span class="tag-pill">#{tag}</span>
										))}
									</div>
								)}
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>

		<Footer />
	</body>
</html>

<style>
.page-hero {
	background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
	border-bottom: 1px solid var(--color-border);
	padding: 3.5rem 0 3rem;
}
.page-hero-inner {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 2rem;
}
.page-hero-title {
	font-family: var(--font-serif);
	font-size: 2.2rem;
	margin: 0 0 0.3rem;
}
.page-hero-sub {
	font-size: 0.85rem;
	color: var(--color-text-muted);
	margin: 0;
	letter-spacing: 0.05em;
}

.blog-main {
	max-width: 1100px;
	margin: 0 auto;
	padding: 3rem 2rem 4rem;
}

.post-list {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.5rem;
}

/* hero (first) card — full-bleed photo with text overlay */
.post-card--hero {
	grid-column: 1 / -1;
	position: relative;
	height: 360px;
	overflow: hidden;
}
.post-card--hero > a {
	display: block;
	position: relative;
	height: 100%;
	text-decoration: none;
	color: inherit;
}
/* 画像：カード全体を覆う */
.post-card--hero .card-img {
	position: absolute;
	inset: 0;
	overflow: hidden;
}
.post-card--hero .card-img img {
	width: 100% !important;
	height: 100% !important;
	object-fit: cover !important;
	border-radius: 0 !important;
	transition: transform .5s ease !important;
}
.post-card--hero:hover .card-img img {
	transform: scale(1.03);
}
/* グラデーションオーバーレイ */
.post-card--hero::after {
	content: '';
	position: absolute;
	inset: 0;
	background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.22) 55%, transparent 100%);
	pointer-events: none;
	z-index: 1;
	border-radius: var(--radius-lg);
}
/* テキスト：画像下部に重ねる */
.post-card--hero .card-body {
	position: absolute !important;
	bottom: 0;
	left: 0;
	right: 0;
	z-index: 2;
	padding: 2rem 2.5rem !important;
	background: none !important;
}
.post-card--hero .card-date {
	color: rgba(255,255,255,0.6) !important;
}
.post-card--hero .card-title {
	font-size: 1.6rem !important;
	margin-bottom: 0.6rem !important;
	color: #fff !important;
	line-height: 1.4 !important;
}
.post-card--hero:hover .card-title {
	color: #fff !important;
}
.post-card--hero .card-desc {
	display: block !important;
	color: rgba(255,255,255,0.78) !important;
	margin-bottom: 0.75rem !important;
}
.post-card--hero .card-tags .tag-pill {
	background: rgba(255,255,255,0.15) !important;
	color: rgba(255,255,255,0.82) !important;
}

/* normal card */
.post-card {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-lg);
	overflow: hidden;
	transition: box-shadow .25s, transform .25s;
}
.post-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.post-card > a, .post-card:not(.post-card--hero) > a {
	display: block;
	text-decoration: none;
	color: inherit;
	height: 100%;
}
.card-img { overflow: hidden; }
.card-img img { width: 100%; height: 200px; object-fit: cover; display: block; transition: transform .4s; border-radius: 0; }
.post-card:hover .card-img img { transform: scale(1.04); }

.card-body { padding: 1.2rem 1.4rem 1.5rem; }
.card-date { font-size: 0.75rem; color: var(--color-text-light); letter-spacing: 0.06em; margin: 0 0 0.4rem; }
.card-title { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.55rem; line-height: 1.5; }
.post-card:hover .card-title { color: var(--color-accent); }
.card-desc { font-size: 0.83rem; color: var(--color-text-muted); margin: 0 0 0.8rem; line-height: 1.7; display: none; }
.card-tags { display: flex; flex-wrap: wrap; gap: 0.35em; margin-top: 0.5rem; }

@media (max-width: 900px) {
	.post-list { grid-template-columns: repeat(2, 1fr); }
	.post-card--hero { height: 280px; }
	.post-card--hero .card-body { padding: 1.5rem 1.75rem !important; }
	.post-card--hero .card-title { font-size: 1.35rem !important; }
}
@media (max-width: 600px) {
	.blog-main { padding: 2rem 1rem 3rem; }
	.post-list { grid-template-columns: 1fr; }
}
</style>
