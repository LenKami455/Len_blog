---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import PhotologPost from '../../layouts/PhotologPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const isPhotolog = post.data.category === 'フォトログ';

// 読了時間（日本語ベース: 約550字/分。タグや記法を除いた本文文字数から概算）
const plainText = (post.body ?? '')
	.replace(/<[^>]*>/g, '')
	.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
	.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
	.replace(/[#>*`\-|]/g, '')
	.replace(/\s+/g, '');
const readingMinutes = Math.max(1, Math.round(plainText.length / 550));
---

{isPhotolog ? (
	<PhotologPost {...post.data} postId={post.id}>
		<Content />
	</PhotologPost>
) : (
	<BlogPost {...post.data} postId={post.id} readingMinutes={readingMinutes}>
		<Content />
	</BlogPost>
)}
