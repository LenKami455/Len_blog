---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const allPosts = await getCollection('blog');
const photologs = allPosts
  .filter(p => p.data.category === 'フォトログ')
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// 通常フォトログ：NNN-photolog-volX
// 旅行フォトログ：NNN-{trip}-photolog-volX
const regularPosts = photologs.filter(p => /^\d+-photolog-vol/.test(p.id));
const tripPosts = photologs.filter(p => !/^\d+-photolog-vol/.test(p.id));

// 旅行フォトログを trip 名でグルーピング
type TripGroup = { name: string; label: string; subtitle: string; posts: typeof tripPosts };
const tripMeta: Record<string, { label: string; subtitle: string; titleReplace?: [string, string] }> = {
  cebu: { label: 'cebu trip', subtitle: 'Sep. 2025 — 3泊4日', titleReplace: ['セブ島旅行フォトログ', 'cebu trip'] },
  hokkaido: { label: 'hokkaido trip', subtitle: 'Dec. 2025 — 2泊3日', titleReplace: ['北海道旅行フォトログ', 'hokkaido trip'] },
  fukuoka: { label: 'fukuoka trip', subtitle: 'Feb. 2026 — 2泊3日', titleReplace: ['福岡', 'Fukuoka'] },
  takayama: { label: 'takayama trip', subtitle: 'Mar. 2026 — 1泊2日', titleReplace: ['飛騨高山', 'Takayama'] },
  minoh: { label: 'minoh trip', subtitle: 'Jun. 2026 — 日帰り', titleReplace: ['箕面', 'Minoh'] },
};

const tripGroupsMap = new Map<string, typeof tripPosts>();
for (const p of tripPosts) {
  const m = p.id.match(/^\d+-(\w+)-photolog-vol/);
  if (!m) continue;
  const name = m[1];
  if (!tripGroupsMap.has(name)) tripGroupsMap.set(name, []);
  tripGroupsMap.get(name)!.push(p);
}
const tripGroups: TripGroup[] = [];
for (const [name, groupPosts] of tripGroupsMap) {
  const meta = tripMeta[name] ?? { label: `${name} trip`, subtitle: '' };
  tripGroups.push({
    name,
    label: meta.label,
    subtitle: meta.subtitle,
    posts: groupPosts,
  });
}
// 既存変数名を維持
const posts = regularPosts;

function formatDate(date: Date) {
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long' });
}

// インデックスページ表示用タイトル（英語化）
function displayTitle(title: string, tripName?: string): string {
  if (tripName && tripMeta[tripName]) {
    const [from, to] = tripMeta[tripName].titleReplace ?? [];
    if (from && to) return title.replace(from, to);
  }
  return title.replace('フォトログ', 'photolog');
}
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`Photolog | ${SITE_TITLE}`} description="カメラを持って歩いた記録。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Noto+Serif+JP:wght@300;400&display=swap" rel="stylesheet" />
  </head>
  <body class="pl-body">
    <Header />

    <main class="pl-main">

      <!-- ── Page header ───────────────── -->
      <header class="pl-page-header">
        <p class="pl-eyebrow">photo log</p>
        <h1 class="pl-page-title">photolog.</h1>

        <!-- ── Index nav ─────────────── -->
        <nav class="pl-index" aria-label="フォトログ インデックス">
          {posts.map((post) => {
            const volMatch = post.id.match(/vol(\d+)/i);
            const volNum = volMatch ? volMatch[1] : post.id;
            const anchor = `vol-${volNum}`;
            return (
              <a href={`#${anchor}`} class="pl-index-link">
                vol.{volNum}
              </a>
            );
          })}
          {tripGroups.map((trip) => (
            <>
              <span class="pl-index-sep" aria-hidden="true">·</span>
              {trip.posts.map((post) => {
                const volMatch = post.id.match(/vol(\d+)/i);
                const volNum = volMatch ? volMatch[1] : post.id;
                const anchor = `${trip.name}-vol-${volNum}`;
                const tripLabel = trip.name.charAt(0).toUpperCase() + trip.name.slice(1);
                return (
                  <a href={`#${anchor}`} class="pl-index-link pl-index-link--trip">
                    {tripLabel} vol.{volNum}
                  </a>
                );
              })}
            </>
          ))}
        </nav>
      </header>

      <!-- ── Entry list ────────────────── -->
      <div class="pl-entries">
        {posts.map((post, i) => {
          const volMatch = post.id.match(/vol(\d+)/i);
          const volNum = volMatch ? volMatch[1] : String(i + 1);
          return (
          <a href={`/blog/${post.id}/`} class="pl-entry reveal" id={`vol-${volNum}`}>

            <!-- 写真 -->
            {post.data.heroImage && (
              <img
                class="pl-entry-img"
                src={post.data.heroImage}
                alt={post.data.title}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            )}

            <!-- テキスト：写真の右側に重ねる -->
            <div class="pl-entry-text">
              <p class="pl-entry-title">{displayTitle(post.data.title)}</p>
              <p class="pl-entry-desc">{post.data.description}</p>
              <span class="pl-entry-date">{formatDate(post.data.pubDate)}</span>
            </div>

          </a>
          );
        })}
      </div>

      {tripGroups.map((trip) => (
        <>
          <!-- ── Trip photolog section ────── -->
          <header class="pl-trip-header">
            <p class="pl-eyebrow">trip photolog</p>
            <h2 class="pl-trip-title">{trip.label}<span class="pl-trip-title-em">.</span></h2>
            {trip.subtitle && <p class="pl-trip-desc">{trip.subtitle}</p>}
          </header>

          <div class="pl-entries">
            {trip.posts.map((post, i) => {
              const volMatch = post.id.match(/vol(\d+)/i);
              const volNum = volMatch ? volMatch[1] : String(i + 1);
              return (
              <a href={`/blog/${post.id}/`} class="pl-entry reveal" id={`${trip.name}-vol-${volNum}`}>
                {post.data.heroImage && (
                  <img
                    class="pl-entry-img"
                    src={post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                  />
                )}
                <div class="pl-entry-text">
                  <p class="pl-entry-title">{displayTitle(post.data.title, trip.name)}</p>
                  <p class="pl-entry-desc">{post.data.description}</p>
                  <span class="pl-entry-date">{formatDate(post.data.pubDate)}</span>
                </div>
              </a>
              );
            })}
          </div>
        </>
      ))}

    </main>

    <Footer />
  </body>
</html>

<style>
/* ── Body ───────────────────────────────────── */
.pl-body {
  background: #fff;
  color: #1a1a1a;
}

/* ── Header overrides（photolog専用） ─────────── */
/* 上部ヘッダー（流れて消えるほう）：白背景に統一 */
.pl-body :global(.header-top) {
  background: #fff;
}
/* コンパクトヘッダー（追従するほう） */
.pl-body :global(.header-compact) {
  background: rgba(255,255,255,0.96);
  border-bottom-color: #ebebeb;
}
/* ナビリンク：Cormorant Garamond・細め */
.pl-body :global(.header-nav a) {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: clamp(0.82rem, 1.2vw, 0.95rem);
  letter-spacing: 0.12em;
  color: #bbb;
}
/* hover / active */
.pl-body :global(.header-nav a:hover),
.pl-body :global(.header-nav a.active) {
  color: #333;
  background: transparent;
  font-weight: 400;
}
/* アイコン（検索・SNS） */
.pl-body :global(.nav-icon-btn) {
  color: #ccc !important;
}
.pl-body :global(.nav-icon-btn:hover) {
  color: #555 !important;
}
/* 縦セパレータ */
.pl-body :global(.nav-sep) {
  background: #ebebeb;
}
/* ロゴを少し薄く */
.pl-body :global(.k),
.pl-body :global(.dot) {
  color: #888;
}
.pl-body :global(.h) {
  color: #888;
}
.pl-body :global(.site-logo:hover .k),
.pl-body :global(.site-logo:hover .h) {
  color: #444;
}

.pl-body :global(footer) {
  background: #fff;
  border-top: 1px solid #e8e8e8;
}

/* ── Page header ────────────────────────────── */
.pl-main {
  min-height: 80vh;
  /* global.css の max-width: 780px を上書き */
  max-width: none;
  padding: 0;
}

.pl-page-header {
  padding: 4rem 4rem 3rem;
}
.pl-eyebrow {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.65rem;
  letter-spacing: 0.55em;
  color: #ccc;
  text-transform: uppercase;
  margin: 0 0 0.75rem;
}
.pl-page-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-style: italic;
  font-size: clamp(2.8rem, 7vw, 4.5rem);
  color: #111;
  letter-spacing: -0.01em;
  line-height: 1;
  margin: 0;
}

/* ── Index nav ──────────────────────────────── */
.pl-index {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 2rem;
}
.pl-index-link {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.72rem;
  letter-spacing: 0.28em;
  color: #bbb;
  text-decoration: none;
  border: 1px solid #e0e0e0;
  border-radius: 999px;
  padding: 0.3em 0.9em;
  transition: color .2s, border-color .2s;
}
.pl-index-link:hover {
  color: #555;
  border-color: #bbb;
}
.pl-index-link--trip {
  border-color: #d4c5b0;
  color: #a08c6e;
}
.pl-index-link--trip:hover {
  color: #6d5a3d;
  border-color: #a08c6e;
}
.pl-index-sep {
  display: inline-flex;
  align-items: center;
  color: #ddd;
  padding: 0 0.25rem;
  font-size: 0.9rem;
}

/* ── Trip section header ─────────────────── */
.pl-trip-header {
  padding: 5rem 4rem 2rem;
  margin-top: 2rem;
  border-top: 1px solid #eee;
}
.pl-trip-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-style: italic;
  font-size: clamp(2rem, 4.5vw, 2.8rem);
  color: #111;
  letter-spacing: 0.01em;
  line-height: 1;
  margin: 0;
}
.pl-trip-title-em {
  color: #c9b896;
  font-style: normal;
}
.pl-trip-desc {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  color: #888;
  margin: 1rem 0 0;
}

/* ── Entries ────────────────────────────────── */
.pl-entries {
  padding: 1rem 0 6rem;
}

/* ── Entry ──────────────────────────────────── */
.pl-entry {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  margin-bottom: 4rem;
}
.pl-entry:last-child { margin-bottom: 6rem; }

/* 写真：右寄せで幅62% → 左38%がテキストエリア（白背景） */
/* 縦写真の hero も 3:2 に統一クロップして一覧の高さを揃える */
.pl-entry-img {
  display: block;
  width: 62%;
  aspect-ratio: 3 / 2;
  height: auto;
  object-fit: cover;
  margin-left: auto;
  transition: opacity .6s;
}
.pl-entry:hover .pl-entry-img { opacity: 0.93; }

/* テキスト：写真の縦中央・左エリアに配置 */
.pl-entry-text {
  position: absolute;
  left: 4rem;
  top: 50%;
  transform: translateY(-50%);
  width: 33%;
  text-align: left;
  pointer-events: none;
}

.pl-entry-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-style: italic;
  font-size: clamp(2rem, 3.2vw, 2.8rem);
  letter-spacing: 0.01em;
  line-height: 1.15;
  margin: 0 0 1rem;
  color: #111;
}
.pl-entry-desc {
  font-family: 'Noto Serif JP', Georgia, serif;
  font-weight: 300;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  line-height: 2;
  margin: 0 0 0.75rem;
  color: #777;
}
.pl-entry-date {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 300;
  font-size: 0.72rem;
  letter-spacing: 0.3em;
  display: block;
  color: #aaa;
}

/* ── Responsive ─────────────────────────────── */

/* タブレット：写真フル幅、テキストを写真左下に白文字で重ねる */
@media (max-width: 900px) {
  .pl-entry { margin-bottom: 2.5rem; }
  .pl-entry-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  /* 写真下部にグラデーションオーバーレイ */
  .pl-entry::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 55%;
    background: linear-gradient(to top, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.18) 60%, transparent 100%);
    pointer-events: none;
  }

  .pl-entry-text {
    left: 2rem;
    top: auto;
    transform: none;
    bottom: 2rem;
    width: 70%;
    z-index: 1;
  }
  .pl-entry-title {
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .pl-entry-desc {
    color: rgba(255,255,255,0.9);
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
  .pl-entry-date {
    color: rgba(255,255,255,0.75);
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
}

/* スマホ：テキストを写真の下に出す */
@media (max-width: 560px) {
  .pl-page-header { padding: 3rem 1.25rem 2rem; }
  .pl-trip-header { padding: 3.5rem 1.25rem 1.5rem; }
  .pl-index { margin-top: 1.25rem; }
  .pl-entry { margin-bottom: 3rem; }
  /* タブレット用グラデーションオーバーレイを消す */
  .pl-entry::after { display: none; }
  .pl-entry-text {
    position: static;
    width: 100%;
    bottom: auto;
    text-align: left;
    padding: 1rem 1.25rem 0;
    pointer-events: auto;
  }
  .pl-entry-title { color: #111; text-shadow: none; font-size: 1.6rem; }
  .pl-entry-desc  { color: #888; text-shadow: none; }
  .pl-entry-date  { color: #bbb; text-shadow: none; }
}
</style>
