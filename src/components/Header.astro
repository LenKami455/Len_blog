---
import { SNS_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SiteLogo from './SiteLogo.astro';
import SocialIcons from './SocialIcons.astro';
---

<!-- スクロール検出用センチネル -->
<div class="header-sentinel" aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
	<div class="header-inner">

		<!-- ロゴ -->
		<SiteLogo />

		<!-- ナビゲーション -->
		<nav class="header-nav" aria-label="メインナビゲーション">
			<HeaderLink href="/blog">記事</HeaderLink>
			<HeaderLink href="/photolog">photolog</HeaderLink>
			<HeaderLink href="/tags">タグ</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>

			<!-- 検索 -->
			<a href="/search" class="nav-icon-btn" aria-label="検索">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
					fill="none" stroke="currentColor" stroke-width="2"
					stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</a>

			<span class="nav-sep" aria-hidden="true"></span>

			<!-- SNS -->
			{SNS_LINKS.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer"
					class="nav-icon-btn" aria-label={link.label}>
					<SocialIcons icon={link.icon} size={16} />
				</a>
			))}
		</nav>

	</div>
</header>

<!-- ヘッダー（fixed）分の空間を確保するスペーサー。
     hero-slider などフルブリードの要素は CSS で打ち消す -->
<div class="header-spacer" aria-hidden="true"></div>

<script>
	// IntersectionObserver で sentinel が画面外に出たら is-scrolled を付ける。
	// scrollY を見る方式だとヘッダー高さ変化で再レイアウトが起きて閾値近辺でガタつくため。
	(() => {
		const header = document.getElementById('siteHeader');
		const sentinel = document.querySelector('.header-sentinel');
		if (!header || !sentinel) return;
		const io = new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				header.classList.remove('is-scrolled');
			} else {
				header.classList.add('is-scrolled');
			}
		}, { threshold: 0 });
		io.observe(sentinel);
	})();
</script>

<style>
	/* スクロール検出用 sentinel（absolute なのでレイアウトに影響しない）*/
	.header-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 40px;
		pointer-events: none;
		visibility: hidden;
	}

	/* fixed ヘッダー分のスペースを確保する透明スペーサー */
	.header-spacer {
		height: 64px;        /* スクロール後のヘッダー高さに合わせる */
		pointer-events: none;
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(248, 245, 240, 0.94);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid transparent;
		transition: background .35s ease, border-color .35s ease, box-shadow .35s ease;
	}
	.site-header.is-scrolled {
		background: rgba(255, 255, 255, 0.96);
		border-bottom-color: var(--color-border);
		box-shadow: 0 4px 18px rgba(0,0,0,0.08);
	}

	/* ── 上部状態：ロゴ中央・ナビ下 ─────────── */
	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.5rem clamp(1rem, 4vw, 3rem) 1.1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
		transition: padding .35s ease, gap .35s ease;
	}

	/* ── スクロール後：ロゴ左・ナビ右の横一列 ── */
	.site-header.is-scrolled .header-inner {
		flex-direction: row;
		justify-content: space-between;
		gap: clamp(0.5rem, 3vw, 2rem);
		padding: 0 clamp(1rem, 4vw, 3rem);
		height: 64px;
	}

	/* ロゴサイズ（上部は大きめ、スクロール後に縮む）*/
	.site-header :global(.site-logo) {
		transition: transform .35s ease;
		transform: scale(1.2);
		transform-origin: center center;
	}
	.site-header.is-scrolled :global(.site-logo) {
		transform: scale(1);
		transform-origin: left center;
	}

	/* ── ナビゲーション ──────────────────── */
	.header-nav {
		display: flex;
		align-items: center;
		/* 各アイテム間の gap がウィンドウ幅で伸縮 */
		gap: clamp(0.1rem, 1.8vw, 1.1rem);
		flex-shrink: 1;
		min-width: 0;
	}

	/* テキストリンク */
	.header-nav :global(a) {
		display: inline-flex;
		align-items: center;
		padding: 0.35em clamp(0.3em, 1vw, 0.65em);
		font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
		font-size: clamp(0.78rem, 1.2vw, 0.9rem);
		color: #666;
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color .18s, background .18s;
		white-space: nowrap;
		letter-spacing: 0.04em;
	}
	.header-nav :global(a:hover),
	.header-nav :global(a.active) {
		color: #333;
		background: var(--color-bg-alt);
	}
	.header-nav :global(a.active) {
		font-weight: 700;
	}

	/* アイコンボタン（検索・SNS） */
	.nav-icon-btn {
		width: 32px !important;
		height: 32px !important;
		padding: 0 !important;
		justify-content: center;
		color: #888 !important;
		flex-shrink: 0;
	}
	.nav-icon-btn:hover {
		color: var(--color-accent) !important;
	}

	/* 縦区切り */
	.nav-sep {
		display: inline-block;
		width: 1px;
		height: 16px;
		background: var(--color-border);
		flex-shrink: 0;
		margin: 0 clamp(0.1rem, 0.5vw, 0.3rem);
	}

	/* ── タブレット：SNSを非表示、間隔を詰める ── */
	@media (max-width: 768px) {
		.header-inner {
			padding: 1.1rem clamp(1rem, 4vw, 3rem) 0.85rem;
			gap: 0.7rem;
		}
		.site-header.is-scrolled .header-inner { height: 56px; padding: 0 clamp(1rem, 4vw, 3rem); }
		.nav-sep,
		.header-nav a[target="_blank"] {
			display: none !important;
		}
	}

	/* ── スマホ：ロゴを小さく・タグ非表示 ── */
	@media (max-width: 480px) {
		:global(.k) { font-size: 0.9rem; }
		:global(.h) { font-size: 0.7rem; }
		:global(.dot) { font-size: 0.9rem; }

		.header-inner {
			padding: 1rem 0.75rem 0.85rem;
			gap: 0.6rem;
		}
		.site-header.is-scrolled .header-inner {
			padding: 0 0.75rem;
			gap: 0.25rem;
		}
		.header-nav {
			gap: 0;
		}
		.header-nav :global(a) {
			padding: 0.35em 0.3em;
			font-size: 0.75rem;
		}
		/* タグページへのリンクは小画面では非表示 */
		.header-nav :global(a[href="/tags"]) {
			display: none !important;
		}
	}

	/* ── 極小スマホ（320px等）: さらに詰める ── */
	@media (max-width: 360px) {
		:global(.k) { font-size: 0.8rem; }
		:global(.h) { font-size: 0.62rem; }
		:global(.dot) { font-size: 0.8rem; }

		.header-inner {
			padding: 0.85rem 0.5rem 0.75rem;
			gap: 0.5rem;
		}
		.site-header.is-scrolled .header-inner {
			padding: 0 0.5rem;
			gap: 0;
		}
		.header-nav :global(a) {
			padding: 0.35em 0.2em;
			font-size: 0.7rem;
		}
	}
</style>
