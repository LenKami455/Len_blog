---
import { SNS_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SiteLogo from './SiteLogo.astro';
import SocialIcons from './SocialIcons.astro';
---

<!-- ① 上部ヘッダー（ドキュメントフロー内・スクロールで流れて消える）-->
<header class="header-top">
	<div class="header-top-inner">
		<div class="header-top-logo">
			<SiteLogo />
		</div>
		<nav class="header-nav header-nav--top" aria-label="メインナビゲーション（上部）">
			<HeaderLink href="/blog">記事</HeaderLink>
			<HeaderLink href="/photolog">photolog</HeaderLink>
			<HeaderLink href="/tags">タグ</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>

			<a href="/search" class="nav-icon-btn" aria-label="検索">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
					fill="none" stroke="currentColor" stroke-width="2"
					stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</a>

			<span class="nav-sep" aria-hidden="true"></span>

			{SNS_LINKS.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer"
					class="nav-icon-btn" aria-label={link.label}>
					<SocialIcons icon={link.icon} size={16} />
				</a>
			))}
		</nav>
	</div>
</header>

<!-- 上部ヘッダーが画面から消えたかを検出する sentinel -->
<div class="header-sentinel" aria-hidden="true"></div>

<!-- ② コンパクトヘッダー（fixed・初期は非表示、上部ヘッダーが消えるとスーッと降りてくる）-->
<header class="header-compact" id="siteHeaderCompact">
	<div class="header-compact-inner">
		<SiteLogo />
		<nav class="header-nav" aria-label="メインナビゲーション">
			<HeaderLink href="/blog">記事</HeaderLink>
			<HeaderLink href="/photolog">photolog</HeaderLink>
			<HeaderLink href="/tags">タグ</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>

			<a href="/search" class="nav-icon-btn" aria-label="検索">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
					fill="none" stroke="currentColor" stroke-width="2"
					stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"/>
					<line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
			</a>

			<span class="nav-sep" aria-hidden="true"></span>

			{SNS_LINKS.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer"
					class="nav-icon-btn" aria-label={link.label}>
					<SocialIcons icon={link.icon} size={16} />
				</a>
			))}
		</nav>
	</div>
</header>

<script>
	// sentinel が viewport から消えた瞬間にコンパクトヘッダーをスライドイン
	let headerIO: IntersectionObserver | null = null;

	function initCompactHeader() {
		headerIO?.disconnect();
		const compact = document.getElementById('siteHeaderCompact');
		const sentinel = document.querySelector('.header-sentinel');
		if (!compact || !sentinel) return;
		headerIO = new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				compact.classList.remove('is-visible');
			} else {
				compact.classList.add('is-visible');
			}
		}, { threshold: 0 });
		headerIO.observe(sentinel);
	}

	initCompactHeader();
	document.addEventListener('astro:page-load', initCompactHeader);
</script>

<style>
	/* ── 上部ヘッダー（フロー内、流れて消える）─────────── */
	.header-top {
		background: var(--color-bg);
		border-bottom: 1px solid transparent;
	}
	.header-top-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem clamp(1rem, 4vw, 3rem) 1.4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
	}
	/* タイトルロゴを大きく */
	.header-top-logo {
		transform: scale(1.5);
		transform-origin: center;
		margin-bottom: 0.5rem;
	}

	/* sentinel：高さ0で完全に消えたタイミングを検出 */
	.header-sentinel {
		height: 1px;
		width: 100%;
		pointer-events: none;
	}

	/* ── コンパクトヘッダー（fixed、スライドイン）─────────── */
	.header-compact {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.96);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
		box-shadow: 0 4px 18px rgba(0,0,0,0.06);

		/* 初期は画面の上に隠れている */
		transform: translateY(-100%);
		transition: transform .4s cubic-bezier(0.22, 0.61, 0.36, 1);
	}
	.header-compact.is-visible {
		transform: translateY(0);
	}
	.header-compact-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 3rem);
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(0.5rem, 3vw, 2rem);
	}

	/* ── ナビゲーション（両ヘッダー共通）───────────────── */
	.header-nav {
		display: flex;
		align-items: center;
		gap: clamp(0.1rem, 1.8vw, 1.1rem);
		flex-shrink: 1;
		min-width: 0;
	}

	.header-nav :global(a) {
		display: inline-flex;
		align-items: center;
		padding: 0.35em clamp(0.3em, 1vw, 0.65em);
		font-family: 'BIZ UDPGothic', 'Noto Sans JP', sans-serif;
		font-size: clamp(0.78rem, 1.2vw, 0.9rem);
		color: #666;
		text-decoration: none;
		border-radius: var(--radius-sm);
		transition: color .18s, background .18s;
		white-space: nowrap;
		letter-spacing: 0.04em;
	}
	.header-nav :global(a:hover),
	.header-nav :global(a.active) {
		color: #333;
		background: var(--color-bg-alt);
	}
	.header-nav :global(a.active) {
		font-weight: 700;
	}

	/* アイコンボタン */
	.nav-icon-btn {
		width: 32px !important;
		height: 32px !important;
		padding: 0 !important;
		justify-content: center;
		color: #888 !important;
		flex-shrink: 0;
	}
	.nav-icon-btn:hover {
		color: var(--color-accent) !important;
	}

	/* 縦区切り */
	.nav-sep {
		display: inline-block;
		width: 1px;
		height: 16px;
		background: var(--color-border);
		flex-shrink: 0;
		margin: 0 clamp(0.1rem, 0.5vw, 0.3rem);
	}

	/* ── タブレット ──────────────────────── */
	@media (max-width: 768px) {
		.header-top-inner {
			padding: 1.5rem clamp(1rem, 4vw, 3rem) 1rem;
			gap: 0.8rem;
		}
		.header-top-logo { transform: scale(1.3); }
		.header-compact-inner { height: 56px; }
		.nav-sep,
		.header-nav a[target="_blank"] {
			display: none !important;
		}
	}

	/* ── スマホ ──────────────────────── */
	@media (max-width: 480px) {
		:global(.k) { font-size: 0.9rem; }
		:global(.h) { font-size: 0.7rem; }
		:global(.dot) { font-size: 0.9rem; }

		.header-top-inner {
			padding: 1.2rem 0.75rem 0.85rem;
			gap: 0.7rem;
		}
		.header-top-logo { transform: scale(1.25); }
		.header-compact-inner { padding: 0 0.75rem; gap: 0.25rem; }
		.header-nav { gap: 0; }
		.header-nav :global(a) {
			padding: 0.35em 0.3em;
			font-size: var(--fs-xs);
		}
		.header-nav :global(a[href="/tags"]) {
			display: none !important;
		}
	}

	/* ── 極小スマホ ──────────────────────── */
	@media (max-width: 360px) {
		:global(.k) { font-size: 0.8rem; }
		:global(.h) { font-size: 0.62rem; }
		:global(.dot) { font-size: 0.8rem; }

		.header-top-inner {
			padding: 1rem 0.5rem 0.7rem;
			gap: 0.6rem;
		}
		.header-top-logo { transform: scale(1.15); }
		.header-compact-inner { padding: 0 0.5rem; gap: 0; }
		.header-nav :global(a) {
			padding: 0.35em 0.2em;
			font-size: var(--fs-2xs);
		}
	}
</style>
